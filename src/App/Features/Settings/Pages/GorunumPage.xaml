<UserControl x:Class="Koy.App.Features.Settings.Pages.GorunumPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavAppearance], Source={x:Static res:Loc.Instance}}" FontSize="22" FontWeight="SemiBold" Foreground="#F4F4F5" />
        <TextBlock Text="{Binding [AppearanceSubtitle], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="#A1A1AA" Margin="0,2,0,16" />

        <!-- TEMA -->
        <TextBlock Text="{Binding [ThemeHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ThemeTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#27272A" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [ThemeSystem], Source={x:Static res:Loc.Instance}}" GroupName="ThemeGroup"
                                     IsChecked="{Binding Theme, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Sistem}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [ThemeDark], Source={x:Static res:Loc.Instance}}" GroupName="ThemeGroup"
                                     IsChecked="{Binding Theme, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Koyu}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [ThemeLight], Source={x:Static res:Loc.Instance}}" GroupName="ThemeGroup"
                                     IsChecked="{Binding Theme, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Açık}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Vurgu Rengi Paleti -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [AccentColorTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <RadioButton Background="#3B82F6" GroupName="AccentColors"
                                 IsChecked="{Binding AccentColor, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=#3B82F6}"
                                 Style="{StaticResource ColorRadioStyle}" />
                    <RadioButton Background="#8B5CF6" GroupName="AccentColors"
                                 IsChecked="{Binding AccentColor, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=#8B5CF6}"
                                 Style="{StaticResource ColorRadioStyle}" />
                    <RadioButton Background="#EC4899" GroupName="AccentColors"
                                 IsChecked="{Binding AccentColor, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=#EC4899}"
                                 Style="{StaticResource ColorRadioStyle}" />
                    <RadioButton Background="#F97316" GroupName="AccentColors"
                                 IsChecked="{Binding AccentColor, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=#F97316}"
                                 Style="{StaticResource ColorRadioStyle}" />
                    <RadioButton Background="#22C55E" GroupName="AccentColors"
                                 IsChecked="{Binding AccentColor, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=#22C55E}"
                                 Style="{StaticResource ColorRadioStyle}" />
                    <RadioButton Background="#14B8A6" GroupName="AccentColors" Margin="0"
                                 IsChecked="{Binding AccentColor, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=#14B8A6}"
                                 Style="{StaticResource ColorRadioStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [UseWindowsAccentTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding UseWindowsAccent}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [MaterialTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [MaterialDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#27272A" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [MaterialSolid], Source={x:Static res:Loc.Instance}}" GroupName="MatGroup"
                                     IsChecked="{Binding Material, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Katı}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [MaterialTranslucent], Source={x:Static res:Loc.Instance}}" GroupName="MatGroup"
                                     IsChecked="{Binding Material, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Yarı saydam}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [CornerRadiusTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <TextBlock Text="18 px" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#D4D4D8" FontSize="13" />
            </Grid>
        </Border>

        <!-- HAREKET -->
        <TextBlock Text="{Binding [MotionHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [AnimationTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#27272A" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [AnimGentle], Source={x:Static res:Loc.Instance}}" GroupName="AnimSpeed"
                                     IsChecked="{Binding AnimationSpeed, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Sakin}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [AnimNormal], Source={x:Static res:Loc.Instance}}" GroupName="AnimSpeed"
                                     IsChecked="{Binding AnimationSpeed, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Normal}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [AnimFast], Source={x:Static res:Loc.Instance}}" GroupName="AnimSpeed"
                                     IsChecked="{Binding AnimationSpeed, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Hızlı}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [AnimOff], Source={x:Static res:Loc.Instance}}" GroupName="AnimSpeed"
                                     IsChecked="{Binding AnimationSpeed, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Kapalı}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ReduceMotionTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding RespectReduceMotion}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
