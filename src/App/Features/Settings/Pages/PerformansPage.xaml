<UserControl x:Class="Koy.App.Features.Settings.Pages.PerformansPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavPerformance], Source={x:Static res:Loc.Instance}}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" />
        <TextBlock Text="{Binding [PerformanceSubtitle], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,2,0,16" />

        <!-- Bellek Durumu -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [MemoryUsageTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [BudgetDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="220">
                    <TextBlock Text="{Binding MemoryUsageText}" HorizontalAlignment="Right" Foreground="{DynamicResource KoyTextSecondary}" FontSize="13" Margin="0,0,0,6" />
                    <!-- Özel Çizilen Bellek Çubuğu -->
                    <Border Height="6" CornerRadius="3" Background="{DynamicResource KoyBorderStrong}">
                        <ProgressBar Value="{Binding MemoryPct}" Maximum="100" Height="6" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource KoyStatusOk}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PİL -->
        <TextBlock Text="{Binding [BatteryHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [BatteryReduceMotion], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding BatterySaverReduceMotion}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- VERİ -->
        <TextBlock Text="{Binding [DataHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [WeatherRefreshTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <ComboBox HorizontalAlignment="Right" Width="180" Height="32" SelectedValuePath="Tag"
                          SelectedValue="{Binding WeatherRefreshInterval}" Style="{StaticResource SettingComboBoxStyle}">
                    <ComboBoxItem Content="{Binding [Interval30m], Source={x:Static res:Loc.Instance}}" Tag="30m" />
                    <ComboBoxItem Content="{Binding [Interval1h], Source={x:Static res:Loc.Instance}}" Tag="1h" />
                    <ComboBoxItem Content="{Binding [IntervalStartupOnly], Source={x:Static res:Loc.Instance}}" Tag="startup" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- Bilgi Kutusu -->
        <Border Style="{StaticResource InfoNoticeStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ" FontSize="14" Foreground="{DynamicResource KoyFgInfo}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding [IdleNotice], Source={x:Static res:Loc.Instance}}"
                           Foreground="{DynamicResource KoyFgInfo}" FontSize="13" TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
