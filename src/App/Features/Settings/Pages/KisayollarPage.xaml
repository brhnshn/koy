<UserControl x:Class="Koy.App.Features.Settings.Pages.KisayollarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavShortcuts], Source={x:Static res:Loc.Instance}}" FontSize="22" FontWeight="SemiBold" Foreground="#F4F4F5" />
        <TextBlock Text="{Binding [ShortcutsSubtitle], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="#A1A1AA" Margin="0,2,0,16" />

        <!-- KLAVYE -->
        <TextBlock Text="{Binding [KeyboardHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <TextBlock Text="{Binding [ShortcutToggleNotch], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Win" /></Border>
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Alt" /></Border>
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="N" /></Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <TextBlock Text="{Binding [ShortcutOpenShelf], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Win" /></Border>
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Alt" /></Border>
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="R" /></Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <TextBlock Text="{Binding [ShortcutToggleDock], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Win" /></Border>
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Alt" /></Border>
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="D" /></Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <TextBlock Text="{Binding [ShortcutOpenMenu], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Win" /></Border>
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Alt" /></Border>
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="K" /></Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <TextBlock Text="{Binding [ShortcutPlayPause], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Win" /></Border>
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Alt" /></Border>
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="{Binding [KeySpace], Source={x:Static res:Loc.Instance}}" /></Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bilgi Kutusu -->
        <Border Style="{StaticResource InfoNoticeStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ" FontSize="14" Foreground="#BFDBFE" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding [ShortcutsNotice], Source={x:Static res:Loc.Instance}}"
                           Foreground="#BFDBFE" FontSize="13" TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>
        </Border>

        <!-- FARE -->
        <TextBlock Text="{Binding [MouseHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [WheelActionTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#27272A" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [WheelSwitchPanel], Source={x:Static res:Loc.Instance}}" GroupName="WheelAction"
                                     IsChecked="{Binding WheelAction, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=0}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [WheelVolume], Source={x:Static res:Loc.Instance}}" GroupName="WheelAction"
                                     IsChecked="{Binding WheelAction, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=1}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [MiddleClickTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#27272A" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [MidClickNewWindow], Source={x:Static res:Loc.Instance}}" GroupName="MidClickAction"
                                     IsChecked="{Binding MiddleClickAction, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=0}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [MidClickClose], Source={x:Static res:Loc.Instance}}" GroupName="MidClickAction"
                                     IsChecked="{Binding MiddleClickAction, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=1}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
