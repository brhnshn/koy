<UserControl x:Class="Koy.App.Features.Settings.Pages.HakkindaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavAbout], Source={x:Static res:Loc.Instance}}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" />
        <TextBlock Text="{Binding [AboutSubtitle], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,2,0,16" />

        <!-- Kimlik Kartı -->
        <Border Background="{DynamicResource KoyBgShell}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource KoyBgWindow}" BorderBrush="{DynamicResource KoyBgControl}" BorderThickness="1" Margin="0,0,16,0">
                    <Path Fill="{DynamicResource KoyAccent}" Data="{StaticResource KoyLogoGeometry}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Koy" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource KoyTextPrimary}" />
                    <TextBlock Text="{Binding AboutStatusText}" FontSize="13" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Eylemler -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <TextBlock Text="{Binding [UpdatesTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                <Button Content="{Binding [CheckNow], Source={x:Static res:Loc.Instance}}" Command="{Binding CheckUpdatesCommand}" HorizontalAlignment="Right" Style="{StaticResource SettingButtonStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <TextBlock Text="{Binding [DiagnosticInfoTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                <Button Content="{Binding [CopyDiagnosticsAction], Source={x:Static res:Loc.Instance}}" Command="{Binding CopyDiagnosticsCommand}" HorizontalAlignment="Right" Style="{StaticResource SettingButtonStyle}" />
            </Grid>
        </Border>

        <!-- SORUN GİDERME (Acil Durum Butonu Dahil) -->
        <TextBlock Text="{Binding [TroubleshootingHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [RestoreTaskbarTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [RestoreTaskbarDesc2], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Button Content="{Binding [RestoreButton], Source={x:Static res:Loc.Instance}}" Command="{Binding RestoreTaskbarCommand}" HorizontalAlignment="Right" Style="{StaticResource SettingButtonStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ResetSettingsTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Button Content="{Binding [ResetButton], Source={x:Static res:Loc.Instance}}" Command="{Binding ResetSettingsCommand}" HorizontalAlignment="Right" Style="{StaticResource DangerButtonStyle}" />
            </Grid>
        </Border>

        <!-- BAĞLANTILAR -->
        <TextBlock Text="{Binding [LinksHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <TextBlock Text="{Binding [SourceCodeTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                <Button Content="{Binding [OpenGitHubAction], Source={x:Static res:Loc.Instance}}" Command="{Binding OpenGitHubCommand}" HorizontalAlignment="Right" Style="{StaticResource SettingButtonStyle}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
