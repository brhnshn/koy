<UserControl x:Class="Koy.App.Features.Settings.Pages.EkranlarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavDisplays], Source={x:Static res:Loc.Instance}}" FontSize="22" FontWeight="SemiBold" Foreground="#F4F4F5" />
        <TextBlock Text="{Binding [DisplaysSubtitle], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="#A1A1AA" Margin="0,2,0,16" />

        <!-- Monitör Harita Alanı -->
        <Border Background="#111113" CornerRadius="12" Height="180" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Ekran 1 (Ana Ekran) -->
                <Border Width="200" Height="118" Background="#27272A" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="8" Margin="0,0,14,0">
                    <Grid>
                        <!-- Mini Çentik -->
                        <Border Width="40" Height="7" Background="#0A0A0B" CornerRadius="0,0,5,5" HorizontalAlignment="Center" VerticalAlignment="Top" />
                        <!-- Sayı 1 -->
                        <TextBlock Text="1" FontSize="22" FontWeight="Bold" Foreground="#F4F4F5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Mini Dock -->
                        <Border Width="64" Height="8" Background="#52525B" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </Grid>
                </Border>

                <!-- Ekran 2 -->
                <Border Width="230" Height="132" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="8">
                    <Grid>
                        <!-- Mini Çentik -->
                        <Border Width="40" Height="7" Background="#0A0A0B" CornerRadius="0,0,5,5" HorizontalAlignment="Center" VerticalAlignment="Top" />
                        <!-- Sayı 2 -->
                        <TextBlock Text="2" FontSize="22" FontWeight="Bold" Foreground="#F4F4F5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Mini Dock -->
                        <Border Width="64" Height="8" Background="#52525B" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- EKRAN 1 -->
        <TextBlock Text="{Binding [PrimaryScreenHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ScreenNotchTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding Screen1Notch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ScreenDockTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding Screen1Dock}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ScreenDockWindowsOnlyTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding Screen1WindowsOnly}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- YENİ EKRANLAR -->
        <TextBlock Text="{Binding [NewDisplaysHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [NewDisplayActionTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#27272A" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [NewDisplayBoth], Source={x:Static res:Loc.Instance}}" GroupName="NewScreenMode" IsChecked="True" Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [NewDisplayNotchOnly], Source={x:Static res:Loc.Instance}}" GroupName="NewScreenMode" Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [NewDisplayNone], Source={x:Static res:Loc.Instance}}" GroupName="NewScreenMode" Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Bilgi Kutusu -->
        <Border Style="{StaticResource InfoNoticeStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ" FontSize="14" Foreground="#BFDBFE" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding [MultiMonitorNotice], Source={x:Static res:Loc.Instance}}"
                           Foreground="#BFDBFE" FontSize="13" TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
