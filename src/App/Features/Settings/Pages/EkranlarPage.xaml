<UserControl x:Class="Koy.App.Features.Settings.Pages.EkranlarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:display="clr-namespace:Koy.Core.Display;assembly=Koy.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavDisplays], Source={x:Static res:Loc.Instance}}" FontSize="22" FontWeight="SemiBold" Foreground="#F4F4F5" />
        <TextBlock Text="{Binding [DisplaysSubtitle], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="#A1A1AA" Margin="0,2,0,16" />

        <!-- Monitör Haritası: bağlı ekranlar gerçek yerleşimleriyle (Windows'taki gibi yan yana / üst üste).
             Ana ekran mavi çerçeveli; çentik ve dock yalnız gösterildikleri ekranda çizilir. -->
        <Border Background="#111113" CornerRadius="12" Height="180" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding MonitorMap.Tiles}"
                          Width="{Binding MonitorMap.Width}"
                          Height="{Binding MonitorMap.Height}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type display:MonitorMapTile}">
                        <Border Width="{Binding Width}" Height="{Binding Height}"
                                Background="#27272A" BorderThickness="2" CornerRadius="8">
                            <Border.ToolTip>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}×{1}">
                                            <Binding Path="PixelWidth" />
                                            <Binding Path="PixelHeight" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border.ToolTip>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#3F3F46" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                            <Setter Property="BorderBrush" Value="#3B82F6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <!-- Mini Çentik -->
                                <Border Width="40" Height="7" Background="#0A0A0B" CornerRadius="0,0,5,5"
                                        HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Visibility="{Binding HasNotch, Converter={StaticResource BoolToVis}}" />
                                <!-- Ekran Numarası -->
                                <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="Bold" Foreground="#F4F4F5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- Mini Dock -->
                                <Border Width="64" Height="8" Background="#52525B" CornerRadius="4"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                        Visibility="{Binding HasDock, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- EKRAN 1 -->
        <TextBlock Style="{StaticResource SectionHeaderStyle}">
            <Run Text="{Binding [PrimaryScreenHeader], Source={x:Static res:Loc.Instance}, Mode=OneWay}" /><Run Text="{Binding PrimaryScreenResolution, Mode=OneWay}" />
        </TextBlock>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ScreenNotchTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding Screen1Notch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ScreenDockTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding Screen1Dock}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ScreenDockWindowsOnlyTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding Screen1WindowsOnly}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- YENİ EKRANLAR -->
        <TextBlock Text="{Binding [NewDisplaysHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [NewDisplayActionTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#27272A" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [NewDisplayBoth], Source={x:Static res:Loc.Instance}}" GroupName="NewScreenMode" IsChecked="True" Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [NewDisplayNotchOnly], Source={x:Static res:Loc.Instance}}" GroupName="NewScreenMode" Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [NewDisplayNone], Source={x:Static res:Loc.Instance}}" GroupName="NewScreenMode" Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Bilgi Kutusu -->
        <Border Style="{StaticResource InfoNoticeStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ" FontSize="14" Foreground="#BFDBFE" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding [MultiMonitorNotice], Source={x:Static res:Loc.Instance}}"
                           Foreground="#BFDBFE" FontSize="13" TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
