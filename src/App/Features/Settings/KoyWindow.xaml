<Window x:Class="Koy.App.Features.Settings.KoyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koy.App.Features.Settings"
        xmlns:pages="clr-namespace:Koy.App.Features.Settings.Pages"
        xmlns:res="clr-namespace:Koy.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:KoyWindowViewModel}"
        Title="Koy"
        Width="880"
        Height="680"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        Foreground="#F4F4F5">

    <Window.Resources>
        <!-- Sayfa Geçiş Animasyonu: Yumuşak Opacity Fade-in -->
        <Style TargetType="UserControl">
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.0" To="1.0"
                                                 Duration="0:0:0.18"
                                                 DecelerationRatio="0.5" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Kenar Çubuğu Gezinme Öğesi Stili -->
        <Style x:Key="SidebarItemStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1F1F23" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Ana Pencere Kabuğu: 880 px, 12 px köşe yuvarlaklığı, koyu arka plan -->
    <Border Background="#18181B"
            BorderBrush="#2E2E33"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" /> <!-- Başlık çubuğu -->
                <RowDefinition Height="*" />  <!-- Ana gövde (Kenar çubuğu + İçerik) -->
            </Grid.RowDefinitions>

            <!-- 1. BAŞLIK ÇUBUĞU (40 px, #111113, alttan 1 px sınır) -->
            <Border Grid.Row="0"
                    Background="#111113"
                    BorderBrush="#232327"
                    BorderThickness="0,0,0,1"
                    Padding="16,0,4,0"
                    CornerRadius="11,11,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <!-- Sol Logo ve Başlık -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Fill="#3B82F6" Data="{StaticResource KoyLogoGeometry}" Width="16" Height="16" Stretch="Uniform" />
                        <TextBlock Text="Koy" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Sağ Pencere Düğmeleri -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Width="44" Height="32" Background="Transparent" BorderThickness="0" Foreground="#D4D4D8"
                                Cursor="Hand" Click="Minimize_Click" ToolTip="Küçült">
                            <TextBlock Text="—" FontSize="10" />
                        </Button>
                        <Button Width="44" Height="32" Background="Transparent" BorderThickness="0" Foreground="#D4D4D8"
                                Cursor="Hand" Click="Close_Click" ToolTip="Pencereyi gizle (Koy çalışmaya devam eder)">
                            <TextBlock Text="✕" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. ANA GÖVDE -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208" /> <!-- Kenar çubuğu -->
                    <ColumnDefinition Width="*" />   <!-- İçerik alanı -->
                </Grid.ColumnDefinitions>

                <!-- SOL KENAR ÇUBUĞU (208 px, #111113, 8 Menü Öğesi) -->
                <Border Grid.Column="0"
                        Background="#111113"
                        Padding="10,16"
                        BorderBrush="#232327"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 8 Navigasyon Öğesi -->
                        <StackPanel Grid.Row="0">
                            <!-- 0. Genel -->
                            <Button Style="{StaticResource SidebarItemStyle}" Click="NavGenel_Click">
                                <Grid>
                                    <Border Width="3" Height="16" CornerRadius="2" Background="#3B82F6" HorizontalAlignment="Left"
                                            Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndicatorConverter.Instance}, ConverterParameter=0}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPageIndex}" Value="0">
                                                        <Setter Property="Foreground" Value="#F4F4F5" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="⚙   "/><Run Text="{Binding [NavGeneral], Source={x:Static res:Loc.Instance}, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <!-- 1. Çentik -->
                            <Button Style="{StaticResource SidebarItemStyle}" Click="NavCentik_Click">
                                <Grid>
                                    <Border Width="3" Height="16" CornerRadius="2" Background="#3B82F6" HorizontalAlignment="Left"
                                            Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndicatorConverter.Instance}, ConverterParameter=1}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPageIndex}" Value="1">
                                                        <Setter Property="Foreground" Value="#F4F4F5" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="◠   "/><Run Text="{Binding [NavNotch], Source={x:Static res:Loc.Instance}, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <!-- 2. Dock -->
                            <Button Style="{StaticResource SidebarItemStyle}" Click="NavDock_Click">
                                <Grid>
                                    <Border Width="3" Height="16" CornerRadius="2" Background="#3B82F6" HorizontalAlignment="Left"
                                            Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndicatorConverter.Instance}, ConverterParameter=2}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPageIndex}" Value="2">
                                                        <Setter Property="Foreground" Value="#F4F4F5" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="▤   "/><Run Text="{Binding [NavDock], Source={x:Static res:Loc.Instance}, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <!-- 3. Ekranlar -->
                            <Button Style="{StaticResource SidebarItemStyle}" Click="NavEkranlar_Click">
                                <Grid>
                                    <Border Width="3" Height="16" CornerRadius="2" Background="#3B82F6" HorizontalAlignment="Left"
                                            Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndicatorConverter.Instance}, ConverterParameter=3}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPageIndex}" Value="3">
                                                        <Setter Property="Foreground" Value="#F4F4F5" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="🖥   "/><Run Text="{Binding [NavDisplays], Source={x:Static res:Loc.Instance}, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <!-- 4. Görünüm -->
                            <Button Style="{StaticResource SidebarItemStyle}" Click="NavGorunum_Click">
                                <Grid>
                                    <Border Width="3" Height="16" CornerRadius="2" Background="#3B82F6" HorizontalAlignment="Left"
                                            Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndicatorConverter.Instance}, ConverterParameter=4}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPageIndex}" Value="4">
                                                        <Setter Property="Foreground" Value="#F4F4F5" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="🎨   "/><Run Text="{Binding [NavAppearance], Source={x:Static res:Loc.Instance}, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <!-- 5. Kısayollar -->
                            <Button Style="{StaticResource SidebarItemStyle}" Click="NavKisayollar_Click">
                                <Grid>
                                    <Border Width="3" Height="16" CornerRadius="2" Background="#3B82F6" HorizontalAlignment="Left"
                                            Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndicatorConverter.Instance}, ConverterParameter=5}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPageIndex}" Value="5">
                                                        <Setter Property="Foreground" Value="#F4F4F5" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="⌨   "/><Run Text="{Binding [NavShortcuts], Source={x:Static res:Loc.Instance}, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <!-- 6. Performans -->
                            <Button Style="{StaticResource SidebarItemStyle}" Click="NavPerformans_Click">
                                <Grid>
                                    <Border Width="3" Height="16" CornerRadius="2" Background="#3B82F6" HorizontalAlignment="Left"
                                            Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndicatorConverter.Instance}, ConverterParameter=6}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPageIndex}" Value="6">
                                                        <Setter Property="Foreground" Value="#F4F4F5" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="⚡   "/><Run Text="{Binding [NavPerformance], Source={x:Static res:Loc.Instance}, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <!-- 7. Hakkında -->
                            <Button Style="{StaticResource SidebarItemStyle}" Click="NavHakkinda_Click">
                                <Grid>
                                    <Border Width="3" Height="16" CornerRadius="2" Background="#3B82F6" HorizontalAlignment="Left"
                                            Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndicatorConverter.Instance}, ConverterParameter=7}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPageIndex}" Value="7">
                                                        <Setter Property="Foreground" Value="#F4F4F5" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="ℹ   "/><Run Text="{Binding [NavAbout], Source={x:Static res:Loc.Instance}, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Alt Eylem: Koy'dan çık -->
                        <Button Grid.Row="1"
                                Height="38"
                                BorderBrush="#3F3F46"
                                BorderThickness="1"
                                Background="Transparent"
                                Foreground="#FCA5A5"
                                Cursor="Hand"
                                Command="{Binding ExitAppCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"
                                            Padding="12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⏻" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding [ExitKoy], Source={x:Static res:Loc.Instance}}" FontSize="14" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- SAĞ İÇERİK ALANI -->
                <ScrollViewer x:Name="ContentScrollViewer"
                              Grid.Column="1"
                              Padding="32,24,24,28"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <!-- 0. Genel -->
                        <pages:GenelPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=0}" />

                        <!-- 1. Çentik -->
                        <pages:CentikPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=1}" />

                        <!-- 2. Dock -->
                        <pages:DockPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=2}" />

                        <!-- 3. Ekranlar -->
                        <pages:EkranlarPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=3}" />

                        <!-- 4. Görünüm -->
                        <pages:GorunumPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=4}" />

                        <!-- 5. Kısayollar -->
                        <pages:KisayollarPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=5}" />

                        <!-- 6. Performans -->
                        <pages:PerformansPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=6}" />

                        <!-- 7. Hakkında -->
                        <pages:HakkindaPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=7}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
