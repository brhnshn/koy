<Window x:Class="Koy.App.Features.Settings.KoyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koy.App.Features.Settings"
        xmlns:pages="clr-namespace:Koy.App.Features.Settings.Pages"
        xmlns:res="clr-namespace:Koy.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:KoyWindowViewModel}"
        Title="Koy"
        Width="880"
        Height="680"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        FontFamily="{DynamicResource KoyFont}"
        Foreground="{DynamicResource KoyTextPrimary}"
        TextOptions.TextFormattingMode="Display">

    <!-- Ana pencere kabuğu: 880 px, köşe yarıçapı ve yüzeyler token'dan gelir -->
    <Border Background="{DynamicResource KoyBgWindow}"
            BorderBrush="{DynamicResource KoyBorderHairline}"
            BorderThickness="1"
            CornerRadius="{DynamicResource KoyRadiusWindow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık çubuğu -->
            <Border Grid.Row="0"
                    Background="{DynamicResource KoyBgShell}"
                    BorderBrush="{DynamicResource KoyBorderShell}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0,6,0"
                    CornerRadius="{DynamicResource KoyRadiusWindowTop}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Fill="{DynamicResource KoyAccent}" Data="{StaticResource KoyLogoGeometry}" Width="16" Height="16" Stretch="Uniform" />
                        <TextBlock Text="Koy" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleButtonStyle}" Tag="{StaticResource IconMinus}" Click="Minimize_Click"
                                ToolTip="{Binding [WindowMinimize], Source={x:Static res:Loc.Instance}}"
                                AutomationProperties.Name="{Binding [WindowMinimize], Source={x:Static res:Loc.Instance}}" />
                        <Button Style="{StaticResource TitleButtonStyle}" Tag="{StaticResource IconX}" Click="Close_Click"
                                ToolTip="{Binding [WindowHideTip], Source={x:Static res:Loc.Instance}}"
                                AutomationProperties.Name="{Binding [WindowHide], Source={x:Static res:Loc.Instance}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Kenar çubuğu -->
                <Border Grid.Column="0"
                        Background="{DynamicResource KoyBgShell}"
                        Padding="10,12"
                        BorderBrush="{DynamicResource KoyBorderShell}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="{DynamicResource KoyRadiusWindowBottomLeft}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconSettings}" Click="NavGenel_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=0}"
                                         Content="{Binding [NavGeneral], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconPanelTop}" Click="NavCentik_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=1}"
                                         Content="{Binding [NavNotch], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconPanelBottom}" Click="NavDock_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=2}"
                                         Content="{Binding [NavDock], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconMonitor}" Click="NavEkranlar_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=3}"
                                         Content="{Binding [NavDisplays], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconPalette}" Click="NavGorunum_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=4}"
                                         Content="{Binding [NavAppearance], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconKeyboard}" Click="NavKisayollar_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=5}"
                                         Content="{Binding [NavShortcuts], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconActivity}" Click="NavPerformans_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=6}"
                                         Content="{Binding [NavPerformance], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconInfo}" Click="NavHakkinda_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=7}"
                                         Content="{Binding [NavAbout], Source={x:Static res:Loc.Instance}}" />
                        </StackPanel>

                        <!-- Alt eylem: Koy'dan çık (Koy'u gerçekten kapatan tek düğme bu ve sağ alt menü) -->
                        <Button Grid.Row="1" Style="{StaticResource DangerButtonStyle}" Height="34"
                                Command="{Binding ExitAppCommand}"
                                AutomationProperties.Name="{Binding [ExitKoy], Source={x:Static res:Loc.Instance}}">
                            <StackPanel Orientation="Horizontal">
                                <res:KoyIcon Data="{StaticResource IconPower}" Size="16" StrokeWidth="2" />
                                <TextBlock Text="{Binding [ExitKoy], Source={x:Static res:Loc.Instance}}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Sağ içerik alanı -->
                <ScrollViewer x:Name="ContentScrollViewer"
                              Grid.Column="1"
                              Padding="28,24,24,24"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="PagesHost">
                        <pages:GenelPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=0}" />
                        <pages:CentikPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=1}" />
                        <pages:DockPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=2}" />
                        <pages:EkranlarPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=3}" />
                        <pages:GorunumPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=4}" />
                        <pages:KisayollarPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=5}" />
                        <pages:PerformansPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=6}" />
                        <pages:HakkindaPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=7}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
