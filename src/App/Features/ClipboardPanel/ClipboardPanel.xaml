<UserControl x:Class="Koy.App.Features.ClipboardPanel.ClipboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.ClipboardPanel"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ClipboardViewModel}"
             Foreground="{DynamicResource KoyNotchText}"
             FontSize="11">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Süzgeç hapı: seçili olan vurgu renginde -->
    <Style x:Key="FilterChip" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="13" Padding="10,6" Background="{DynamicResource KoyNotchClipChip}">
              <TextBlock x:Name="Text" Text="{TemplateBinding Content}" FontSize="11" Foreground="{DynamicResource KoyNotchClipChipText}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="Selected">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource KoyNotchAccentClipboard}" />
                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource KoyNotchTextOnLight}" />
                <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Kart üstündeki küçük simge düğmesi (sabitle, sil) -->
    <Style x:Key="CardIconButton" TargetType="Button">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="11" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource KoyNotchClipChip}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Kartın kendisi de düğme: tıklayınca panoya geri kopyalanır -->
    <Style x:Key="ClipCardButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource KoyNotchText}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="14" Background="{DynamicResource KoyNotchSurface}" Padding="10,6,6,6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource KoyNotchCard}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border CornerRadius="22" Background="{DynamicResource KoyNotchClipCard}" Padding="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Arama, süzgeçler, Temizle -->
      <Grid Grid.Row="0" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Style="{StaticResource NotchInputStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Tag="{Binding [ClipSearch], Source={x:Static res:Loc.Instance}}"
                 AutomationProperties.Name="{Binding [ClipSearch], Source={x:Static res:Loc.Instance}}" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Filters}" Margin="8,0,0,0" Focusable="False" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:ClipboardFilterViewModel}">
              <Button x:Name="Chip" Style="{StaticResource FilterChip}" Margin="0,0,4,0" Content="{Binding Label}"
                      Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding Filter}" />
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter TargetName="Chip" Property="Tag" Value="Selected" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Grid.Column="2" Style="{StaticResource FilterChip}" Margin="4,0,0,0" Command="{Binding ClearCommand}"
                Content="{Binding [ClipClear], Source={x:Static res:Loc.Instance}}" />
      </Grid>

      <!-- Liste: üç sütunlu kart ızgarası -->
      <Grid Grid.Row="1">
        <TextBlock Text="{Binding EmptyText}" FontSize="12" Foreground="{DynamicResource KoyNotchClipSoft}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:ClipboardItemViewModel}">
                <Button Style="{StaticResource ClipCardButton}" Width="166" Height="68" Margin="0,0,6,6"
                        Command="{Binding DataContext.CopyBackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding [ClipCopyBack], Source={x:Static res:Loc.Instance}}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <!-- Kısa süre "Kopyalandı" yazar, sonra tür · zaman -->
                      <TextBlock x:Name="HeaderText" Text="{Binding Header}" FontSize="11" Foreground="{DynamicResource KoyNotchClipSoft}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock x:Name="CopiedText" Text="{Binding [ClipCopied], Source={x:Static res:Loc.Instance}}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource KoyNotchAccentClipboard}" VerticalAlignment="Center" Visibility="Collapsed" />
                      <Button Grid.Column="1" Style="{StaticResource CardIconButton}"
                              Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"
                              ToolTip="{Binding PinTip}"
                              AutomationProperties.Name="{Binding PinTip}">
                        <res:KoyIcon x:Name="PinIcon" Data="{DynamicResource IconPin}" Size="13" Foreground="{DynamicResource KoyNotchClipSoft}" />
                      </Button>
                      <Button Grid.Column="2" Style="{StaticResource CardIconButton}"
                              Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"
                              ToolTip="{Binding [ClipDelete], Source={x:Static res:Loc.Instance}}"
                              AutomationProperties.Name="{Binding [ClipDelete], Source={x:Static res:Loc.Instance}}">
                        <res:KoyIcon Data="{DynamicResource IconTrash2}" Size="13" Foreground="{DynamicResource KoyNotchClipSoft}" />
                      </Button>
                    </Grid>
                    <!-- Metin / bağlantı / kod: ilk satırlar; renkte renk örneği ve renk metni -->
                    <TextBlock x:Name="PreviewText" Grid.Row="1" Text="{Binding Preview}" FontSize="11" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" Margin="0,3,4,0" VerticalAlignment="Top" />
                    <StackPanel x:Name="ColorRow" Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                      <Border Width="26" Height="26" CornerRadius="8" Background="{Binding Swatch}" BorderThickness="1" BorderBrush="{DynamicResource KoyNotchCheckBorder}" />
                      <TextBlock Text="{Binding Preview}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding HasSwatch}" Value="True">
                    <Setter TargetName="ColorRow" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsLink}" Value="True">
                    <Setter TargetName="PreviewText" Property="TextDecorations" Value="Underline" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsCopied}" Value="True">
                    <Setter TargetName="HeaderText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CopiedText" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="PinIcon" Property="Foreground" Value="{DynamicResource KoyNotchAccentClipboard}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <TextBlock Grid.Row="2" Text="{Binding [ClipFooter], Source={x:Static res:Loc.Instance}}" FontSize="10"
                 Foreground="{DynamicResource KoyNotchMuted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
    </Grid>
  </Border>
</UserControl>
