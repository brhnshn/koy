<Window x:Class="Koy.App.Features.Dock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Koy.App.Resources"
        xmlns:local="clr-namespace:Koy.App.Features.Dock"
        Title="Koy Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{x:Static res:Strings.Settings}" Command="{Binding OpenSettingsCommand}"/>
            <Separator/>
            <MenuItem Header="{x:Static res:Strings.Exit}" Command="{Binding ExitCommand}"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid RenderTransformOrigin="0.5, 1">
        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform Y="{Binding TranslationY}"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.Opacity>
            <Binding Path="Opacity"/>
        </Grid.Opacity>

        <!-- Dock Ana Kapsülü -->
        <Border Background="#E61A1A1A"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="20"
                Padding="8,6"
                Margin="12"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="4"
                                  Opacity="0.45"
                                  Direction="270"
                                  Color="#000000"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Windows Başlat Düğmesi -->
                <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Command="{Binding StartMenuCommand}"
                        ToolTip="{x:Static res:Strings.StartMenu}"
                        Width="42"
                        Height="42"
                        Margin="2,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="Transparent"
                                    CornerRadius="12">
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="#4CC2FF"
                                      Data="M 0,0 H 7 V 7 H 0 Z M 8.5,0 H 15.5 V 7 H 8.5 Z M 0,8.5 H 7 V 15.5 H 0 Z M 8.5,8.5 H 15.5 V 15.5 H 8.5 Z"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Dikey Ayırıcı -->
                <Rectangle Width="1"
                           Height="26"
                           Fill="#26FFFFFF"
                           Margin="4,0"/>

                <!-- Dock Öğeleri Listesi -->
                <ItemsControl x:Name="DockItemsList"
                              ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:DockItemViewModel}">
                            <Border x:Name="ItemContainer"
                                    Width="48"
                                    Height="48"
                                    Margin="3,0"
                                    Background="Transparent"
                                    CornerRadius="12"
                                    Cursor="Hand"
                                    ToolTip="{Binding Title}"
                                    MouseLeftButtonUp="OnItemLeftClick"
                                    MouseRightButtonUp="OnItemRightClick"
                                    MouseDown="OnItemMouseDown"
                                    MouseEnter="OnItemMouseEnter"
                                    MouseLeave="OnItemMouseLeave">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static res:Strings.LaunchNewInstance}"
                                                  Command="{Binding MiddleClickCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="{x:Static res:Strings.Close}"
                                                  Command="{Binding CloseCommand}"/>
                                        <MenuItem Header="{x:Static res:Strings.EndTask}"
                                                  Command="{Binding TerminateCommand}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                    </Grid.RowDefinitions>

                                    <!-- Simge ve Büyütme Dönüşümü -->
                                    <Grid Grid.Row="0"
                                          Width="36"
                                          Height="36"
                                          RenderTransformOrigin="0.5, 0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                                        </Grid.RenderTransform>

                                        <!-- Gerçek Simge -->
                                        <Image Source="{Binding Icon}"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Width="34"
                                               Height="34"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                        <!-- Simge Yoksa Yedek Şablon -->
                                        <Border Width="34"
                                                Height="34"
                                                Background="#33FFFFFF"
                                                CornerRadius="8"
                                                Visibility="{Binding Icon, Converter={x:Static local:DockConverters.NullToVisibleConverter}}">
                                            <Path HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Fill="#CCCCCC"
                                                  Data="M 2,2 H 14 V 14 H 2 Z"/>
                                        </Border>
                                    </Grid>

                                    <!-- Çalışan Uygulama Gösterge Noktası -->
                                    <Grid Grid.Row="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Ellipse Width="4"
                                                 Height="4"
                                                 Visibility="{Binding IsRunning, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#88FFFFFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Fill" Value="#4CC2FF"/>
                                                            <Setter Property="Width" Value="10"/>
                                                            <Setter Property="Height" Value="4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Dikey Ayırıcı -->
                <Rectangle Width="1"
                           Height="26"
                           Fill="#26FFFFFF"
                           Margin="4,0"/>

                <!-- Sistem Tepsisi Düğmesi -->
                <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Command="{Binding SystemTrayCommand}"
                        ToolTip="{x:Static res:Strings.SystemTray}"
                        Width="36"
                        Height="42"
                        Margin="2,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="Transparent"
                                    CornerRadius="10">
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="#CCCCCC"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 0,5 L 5,0 L 10,5"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
