<UserControl x:Class="Koy.App.Features.Dock.DockFullWidth"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:local="clr-namespace:Koy.App.Features.Dock"
             xmlns:tray="clr-namespace:Koy.App.Features.Dock.Tray"
             xmlns:recents="clr-namespace:Koy.App.Features.Dock.Recents">

    <!-- Tam Genişlik Modu (Glass / Cam): 44 px yükseklik, üst sınır parıltısı, akrilik koyu arka plan -->
    <Border Background="#D4121216"
            BorderBrush="#26FFFFFF"
            BorderThickness="0,1,0,0"
            Height="44"
            Padding="12,0"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Sol Bölüm: Windows Başlat Düğmesi + Çalan Müzik Hapı -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Windows Başlat Düğmesi -->
                <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Command="{Binding StartMenuCommand}"
                        ToolTip="{x:Static res:Strings.StartMenu}"
                        Width="36"
                        Height="34"
                        Margin="0,0,6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="Transparent"
                                    CornerRadius="8">
                                <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Canvas.Left="1.5" Canvas.Top="1.5" Width="6.5" Height="6.5" RadiusX="1.2" RadiusY="1.2" Fill="#60A5FA"/>
                                    <Rectangle Canvas.Left="10" Canvas.Top="1.5" Width="6.5" Height="6.5" RadiusX="1.2" RadiusY="1.2" Fill="#60A5FA"/>
                                    <Rectangle Canvas.Left="1.5" Canvas.Top="10" Width="6.5" Height="6.5" RadiusX="1.2" RadiusY="1.2" Fill="#60A5FA"/>
                                    <Rectangle Canvas.Left="10" Canvas.Top="10" Width="6.5" Height="6.5" RadiusX="1.2" RadiusY="1.2" Fill="#60A5FA"/>
                                </Canvas>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Çalan Müzik Hapı (Yalnız medya etkinken görünür) -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Background="#14FFFFFF"
                        CornerRadius="8"
                        Padding="6,4"
                        MouseLeftButtonUp="OnNowPlayingClick"
                        ToolTip="Çalan Müzik (Çentiği Aç)"
                        Visibility="{Binding HasNowPlaying, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Albüm Kapağı -->
                        <Border Width="24"
                                Height="24"
                                CornerRadius="5"
                                Background="#27272A"
                                Margin="0,0,8,0">
                            <Image Source="{Binding NowPlayingCover}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Width="24"
                                   Height="24"
                                   Visibility="{Binding NowPlayingCover, Converter={x:Static local:DockConverters.NotNullToVisibleConverter}}"/>
                        </Border>
                        <!-- Şarkı Adı ve Sanatçı -->
                        <StackPanel VerticalAlignment="Center" MaxWidth="170">
                            <TextBlock Text="{Binding NowPlayingTitle}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#F4F4F5"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding NowPlayingArtist}"
                                       FontSize="10"
                                       Foreground="#A1A1AA"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Orta Bölüm: Uygulamalar, aktif olan hap şeklinde adıyla birlikte vurgulu -->
            <ItemsControl Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:DockItemViewModel}">
                        <Border x:Name="ItemContainer"
                                Height="34"
                                Margin="2,0"
                                CornerRadius="8"
                                Cursor="Hand"
                                ToolTip="{Binding Title}"
                                ToolTipService.IsEnabled="{Binding HasOpenWindows, Converter={x:Static local:DockConverters.InverseBoolConverter}}"
                                MouseLeftButtonDown="OnItemLeftDown"
                                MouseMove="OnItemMouseMove"
                                LostMouseCapture="OnItemLostCapture"
                                MouseLeftButtonUp="OnItemLeftClick"
                                MouseRightButtonUp="OnItemRightClick"
                                MouseDown="OnItemMouseDown"
                                MouseEnter="OnItemMouseEnter"
                                MouseLeave="OnItemMouseLeave"
                                ContextMenuOpening="OnItemContextMenuOpening">
                            <!-- Aktif ise hap arka planı rgba(255,255,255,0.14), inaktif ise şeffaf -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="5,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="#24FFFFFF"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1AFFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.RenderTransform>
                                <TranslateTransform X="{Binding OffsetX}"/>
                            </Border.RenderTransform>

                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static res:Strings.LaunchNewInstance}"
                                              Command="{Binding MiddleClickCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{x:Static res:Strings.Close}"
                                              Command="{Binding CloseCommand}"/>
                                    <MenuItem Header="{x:Static res:Strings.EndTask}"
                                              Command="{Binding TerminateCommand}"/>
                                </ContextMenu>
                            </Border.ContextMenu>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 22×22 px Simge -->
                                <Border Width="22"
                                        Height="22"
                                        CornerRadius="5"
                                        Background="Transparent">
                                    <Image Source="{Binding Icon}"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Width="22"
                                           Height="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>

                                <!-- Aktif Uygulama Adı Metin Hapı (11.5 px, #F4F4F5) -->
                                <TextBlock Text="{Binding Title}"
                                           FontSize="11.5"
                                           Foreground="#F4F4F5"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsActive, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sağ Bölüm: Sistem Tepsisi ve Koy Simgesi (36×34 px, 8 px radius, Koy SVG) -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
            <recents:RecentsButton/>
            <tray:TrayButton/>
            <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                    Command="{Binding OpenKoyMenuCommand}"
                    ToolTip="Koy Menüsü"
                    VerticalAlignment="Center"
                    Width="36"
                    Height="34"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                CornerRadius="8">
                            <!-- Koy Marka Logosu -->
                            <Path Fill="#3B82F6" Data="{StaticResource KoyLogoGeometry}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
