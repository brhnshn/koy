<UserControl x:Class="Koy.App.Features.Focus.FocusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Focus"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:tasks="clr-namespace:Koy.Core.Tasks;assembly=Koy.Core"
             xmlns:cal="clr-namespace:Koy.App.Features.Calendar"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:FocusViewModel}"
             Foreground="{DynamicResource KoyNotchText}"
             FontSize="12">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <cal:SelectedTagConverter x:Key="SelectedTag" />

    <!-- Gün · Hafta · Ay: düz yazı bağlantıları, seçili olan açık renk -->
    <Style x:Key="ScopeLinkStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource KoyNotchMuted}" />
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="Selected">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource KoyNotchFocusSoft}" />
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource KoyNotchText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Yuvarlak simge düğmesi (sıfırla, başlat / duraklat) -->
    <Style x:Key="RoundButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Background" Value="{DynamicResource KoyNotchFocusButton}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="19">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Hap düğmesi (hazır süreler, tur, sonraki aşama) -->
    <Style x:Key="ChipButtonStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource KoyNotchText}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="14" Background="{DynamicResource KoyNotchChip}" Padding="12,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource KoyBgHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PageVisibility" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="262" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- SOL KART: alt sekmeler, halka, düğmeler -->
    <Border Grid.Column="0" CornerRadius="22" Background="{DynamicResource KoyNotchFocusCard}" Padding="14">
      <StackPanel HorizontalAlignment="Center">
        <Border CornerRadius="14" Background="{DynamicResource KoyNotchSurface}" Padding="3">
          <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:FocusTabViewModel}">
                <Button Margin="1,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                        Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding Kind}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Pill" CornerRadius="11" Padding="7,5" Background="Transparent">
                        <TextBlock x:Name="Text" Text="{Binding Label}" FontSize="10.5" Foreground="{DynamicResource KoyNotchTextSecondary}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource KoyNotchHover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource KoyNotchAccentFocus}" />
                          <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource KoyNotchSurface}" />
                          <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Grid Width="112" Height="112" Margin="0,8,0,0">
          <local:ArcRing Progress="{Binding Progress}" Thickness="8"
                         TrackBrush="{DynamicResource KoyNotchFocusTrack}" FillBrush="{DynamicResource KoyNotchAccentFocus}" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding TimeText}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" LineHeight="28" LineStackingStrategy="BlockLineHeight" />
            <TextBlock Text="{Binding SubText}" FontSize="10" Foreground="{DynamicResource KoyNotchFocusSoft}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button Style="{StaticResource RoundButtonStyle}" Command="{Binding ResetCommand}"
                  ToolTip="{x:Static res:Strings.Reset}" AutomationProperties.Name="{x:Static res:Strings.Reset}">
            <res:KoyIcon Data="{DynamicResource IconRotateCcw}" Size="16" Foreground="{DynamicResource KoyNotchText}" />
          </Button>
          <Button Style="{StaticResource RoundButtonStyle}" Margin="12,0,0,0" Background="{DynamicResource KoyNotchAccentFocus}"
                  Command="{Binding ToggleCommand}"
                  ToolTip="{Binding [MusicPlayPause], Source={x:Static res:Loc.Instance}}"
                  AutomationProperties.Name="{Binding [MusicPlayPause], Source={x:Static res:Loc.Instance}}">

            <Grid>
              <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource KoyNotchSurface}" Data="M7 4l12 8-12 8z">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
              <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource KoyNotchSurface}" Data="M7 5h4v14H7zM13 5h4v14h-4z">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Grid>
          </Button>
          <Button Style="{StaticResource RoundButtonStyle}" Margin="12,0,0,0" Command="{Binding SkipCommand}"
                  Visibility="{Binding CanSkip, Converter={StaticResource BoolToVis}}"
                  ToolTip="{Binding [FocusSkip], Source={x:Static res:Loc.Instance}}"
                  AutomationProperties.Name="{Binding [FocusSkip], Source={x:Static res:Loc.Instance}}">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource KoyNotchText}" Data="M16 5h2v14h-2zM4 5v14l11-7z" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- SAĞ KART: seçili sekmeye göre. Görev listesi bağlanınca Odak / Mola sekmelerinde bu kartın yerini alır. -->
    <Border Grid.Column="2" CornerRadius="22" Background="{DynamicResource KoyNotchCard}" Padding="14">
      <Grid>
        <!-- Odak / Mola: görev listesi (Bugün · Hafta · Ay) -->
        <Grid DataContext="{Binding Tasks}">
          <Grid.Style>
            <Style TargetType="Grid" BasedOn="{StaticResource PageVisibility}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPomodoroTab, RelativeSource={RelativeSource AncestorType=local:FocusPanel}}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource ScopeLinkStyle}" Command="{Binding SetScopeCommand}" CommandParameter="{x:Static tasks:TaskScope.Day}"
                      Content="{Binding [TaskScopeDay], Source={x:Static res:Loc.Instance}}">
                <Button.Tag><Binding Path="IsDayScope" Converter="{StaticResource SelectedTag}" /></Button.Tag>
              </Button>
              <Button Style="{StaticResource ScopeLinkStyle}" Command="{Binding SetScopeCommand}" CommandParameter="{x:Static tasks:TaskScope.Week}"
                      Content="{Binding [TaskScopeWeek], Source={x:Static res:Loc.Instance}}">
                <Button.Tag><Binding Path="IsWeekScope" Converter="{StaticResource SelectedTag}" /></Button.Tag>
              </Button>
              <Button Style="{StaticResource ScopeLinkStyle}" Command="{Binding SetScopeCommand}" CommandParameter="{x:Static tasks:TaskScope.Month}"
                      Content="{Binding [TaskScopeMonth], Source={x:Static res:Loc.Instance}}">
                <Button.Tag><Binding Path="IsMonthScope" Converter="{StaticResource SelectedTag}" /></Button.Tag>
              </Button>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1">
            <TextBlock Text="{Binding [TaskEmpty], Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="{DynamicResource KoyNotchMuted}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:TaskRowViewModel}">
                    <Grid Margin="0,0,0,2" Height="26">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <!-- Satırın tamamı düğme: tıklayınca tamamlandı / geri al (çentik boş alana tıklayınca kapanır) -->
                      <Button Style="{StaticResource NotchPlainButtonStyle}" HorizontalContentAlignment="Stretch"
                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"
                              ToolTip="{Binding [TaskToggle], Source={x:Static res:Loc.Instance}}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border x:Name="Box" Width="16" Height="16" CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource KoyNotchCheckBorder}"
                                  Background="Transparent" VerticalAlignment="Center">
                            <res:KoyIcon x:Name="Tick" Data="{DynamicResource IconCheck}" Size="10" StrokeWidth="3" Foreground="{DynamicResource KoyNotchSurface}" Visibility="Collapsed" />
                          </Border>
                          <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" Margin="10,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DayText}" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" Margin="0,0,6,0"
                                       Visibility="{Binding HasDay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock x:Name="TimeLabel" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}"
                                       Visibility="{Binding HasTime, Converter={StaticResource BoolToVis}}" />
                            <TextBlock x:Name="NowLabel" Text="{Binding [TaskNow], Source={x:Static res:Loc.Instance}}" FontSize="11"
                                       Foreground="{DynamicResource KoyNotchFocusSoft}" Visibility="Collapsed" />
                          </StackPanel>
                        </Grid>
                      </Button>
                      <Button Grid.Column="1" Style="{StaticResource NotchPlainButtonStyle}" Margin="4,0,0,0" Width="22" Height="22" VerticalAlignment="Center"
                              Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"
                              ToolTip="{Binding [TaskDelete], Source={x:Static res:Loc.Instance}}"
                              AutomationProperties.Name="{Binding [TaskDelete], Source={x:Static res:Loc.Instance}}">
                        <res:KoyIcon Data="{DynamicResource IconX}" Size="12" Foreground="{DynamicResource KoyNotchMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Button>
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Done}" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource KoyNotchAccentFocus}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource KoyNotchAccentFocus}" />
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource KoyNotchDoneText}" />
                        <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsNow}" Value="True">
                        <Setter TargetName="NowLabel" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <!-- Görev ekle: başlık, isteğe bağlı saat, + -->
          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Height="32" MaxLength="80" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{Binding [TaskAdd], Source={x:Static res:Loc.Instance}}"
                     AutomationProperties.Name="{Binding [TaskAdd], Source={x:Static res:Loc.Instance}}">
              <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource NotchInputStyle}">
                  <Setter Property="Background" Value="{DynamicResource KoyNotchChip}" />
                </Style>
              </TextBox.Style>
              <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding AddCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBox Grid.Column="1" Height="32" Margin="6,0,0,0" MaxLength="5" Text="{Binding NewTime, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{Binding [TaskTimeHint], Source={x:Static res:Loc.Instance}}"
                     ToolTip="{Binding [TaskTimeInvalid], Source={x:Static res:Loc.Instance}}"
                     AutomationProperties.Name="{Binding [TaskTimeHint], Source={x:Static res:Loc.Instance}}">
              <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource NotchInputStyle}">
                  <Setter Property="Background" Value="{DynamicResource KoyNotchChip}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding NewTimeInvalid}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource KoyNotchAccentFocus}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
              <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding AddCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="2" Style="{StaticResource NotchPlainButtonStyle}" Margin="6,0,0,0" Command="{Binding AddCommand}"
                    ToolTip="{Binding [TaskAddButton], Source={x:Static res:Loc.Instance}}"
                    AutomationProperties.Name="{Binding [TaskAddButton], Source={x:Static res:Loc.Instance}}">
              <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource KoyNotchText}">
                <res:KoyIcon Data="{DynamicResource IconPlus}" Size="16" StrokeWidth="2.4" Foreground="{DynamicResource KoyNotchSurface}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Button>
          </Grid>
        </Grid>

        <!-- Sayaç: süre ve hazır süreler -->
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid" BasedOn="{StaticResource PageVisibility}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCountdownTab}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <StackPanel>
            <TextBlock Text="{Binding [FocusTabTimer], Source={x:Static res:Loc.Instance}}" FontSize="13" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding CanEditCountdown}">
              <Button Style="{StaticResource RoundButtonStyle}" Command="{Binding DecreaseCountdownCommand}"
                      ToolTip="{Binding [FocusShorter], Source={x:Static res:Loc.Instance}}"
                      AutomationProperties.Name="{Binding [FocusShorter], Source={x:Static res:Loc.Instance}}">
                <res:KoyIcon Data="{DynamicResource IconMinus}" Size="16" Foreground="{DynamicResource KoyNotchText}" />
              </Button>
              <TextBlock Text="{Binding CountdownDurationText}" FontSize="30" FontWeight="SemiBold" Width="110" TextAlignment="Center" VerticalAlignment="Center" />
              <Button Style="{StaticResource RoundButtonStyle}" Command="{Binding IncreaseCountdownCommand}"
                      ToolTip="{Binding [FocusLonger], Source={x:Static res:Loc.Instance}}"
                      AutomationProperties.Name="{Binding [FocusLonger], Source={x:Static res:Loc.Instance}}">
                <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource KoyNotchText}" Data="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" />
              </Button>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,14,0,0" IsEnabled="{Binding CanEditCountdown}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:FocusPreset}">
                  <Button Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,6"
                          Command="{Binding DataContext.SetCountdownMinutesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding Minutes}">
                    <TextBlock Text="{Binding Label}" FontSize="12" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>

        <!-- Kronometre: tur düğmesi ve turlar -->
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid" BasedOn="{StaticResource PageVisibility}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsStopwatchTab}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Button Style="{StaticResource ChipButtonStyle}" Command="{Binding LapCommand}" HorizontalAlignment="Left" IsEnabled="{Binding IsRunning}">
            <TextBlock Text="{Binding [FocusLap], Source={x:Static res:Loc.Instance}}" FontSize="12" />
          </Button>
          <TextBlock Grid.Row="1" Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" TextWrapping="Wrap"
                     Text="{Binding [FocusLapsEmpty], Source={x:Static res:Loc.Instance}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasLaps}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding HasLaps, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Laps}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:FocusLapRow}">
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource KoyNotchMuted}" />
                    <TextBlock Grid.Column="1" Text="{Binding Split}" FontSize="12" Foreground="{DynamicResource KoyNotchFocusSoft}" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="12" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
