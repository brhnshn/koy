<UserControl x:Class="Koy.App.Features.Focus.FocusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Focus"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:FocusViewModel}"
             Foreground="{DynamicResource KoyNotchText}"
             FontSize="12">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Yuvarlak simge düğmesi (sıfırla, başlat / duraklat) -->
    <Style x:Key="RoundButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Background" Value="{DynamicResource KoyNotchFocusButton}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="19">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Hap düğmesi (hazır süreler, tur, sonraki aşama) -->
    <Style x:Key="ChipButtonStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource KoyNotchText}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="14" Background="{DynamicResource KoyNotchChip}" Padding="12,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource KoyBgHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PageVisibility" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="262" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- SOL KART: alt sekmeler, halka, düğmeler -->
    <Border Grid.Column="0" CornerRadius="22" Background="{DynamicResource KoyNotchFocusCard}" Padding="14">
      <StackPanel HorizontalAlignment="Center">
        <Border CornerRadius="14" Background="{DynamicResource KoyNotchSurface}" Padding="3">
          <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:FocusTabViewModel}">
                <Button Margin="1,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                        Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding Kind}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Pill" CornerRadius="11" Padding="7,5" Background="Transparent">
                        <TextBlock x:Name="Text" Text="{Binding Label}" FontSize="10.5" Foreground="{DynamicResource KoyNotchTextSecondary}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource KoyNotchHover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource KoyNotchAccentFocus}" />
                          <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource KoyNotchSurface}" />
                          <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Grid Width="112" Height="112" Margin="0,8,0,0">
          <local:ArcRing Progress="{Binding Progress}" Thickness="8"
                         TrackBrush="{DynamicResource KoyNotchFocusTrack}" FillBrush="{DynamicResource KoyNotchAccentFocus}" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding TimeText}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" LineHeight="28" LineStackingStrategy="BlockLineHeight" />
            <TextBlock Text="{Binding SubText}" FontSize="10" Foreground="{DynamicResource KoyNotchFocusSoft}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button Style="{StaticResource RoundButtonStyle}" Command="{Binding ResetCommand}"
                  ToolTip="{x:Static res:Strings.Reset}" AutomationProperties.Name="{x:Static res:Strings.Reset}">
            <res:KoyIcon Data="{DynamicResource IconRotateCcw}" Size="16" Foreground="{DynamicResource KoyNotchText}" />
          </Button>
          <Button Style="{StaticResource RoundButtonStyle}" Margin="12,0,0,0" Background="{DynamicResource KoyNotchAccentFocus}"
                  Command="{Binding ToggleCommand}"
                  ToolTip="{Binding [MusicPlayPause], Source={x:Static res:Loc.Instance}}"
                  AutomationProperties.Name="{Binding [MusicPlayPause], Source={x:Static res:Loc.Instance}}">

            <Grid>
              <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource KoyNotchSurface}" Data="M7 4l12 8-12 8z">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
              <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource KoyNotchSurface}" Data="M7 5h4v14H7zM13 5h4v14h-4z">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Grid>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- SAĞ KART: seçili sekmeye göre. Görev listesi bağlanınca Odak / Mola sekmelerinde bu kartın yerini alır. -->
    <Border Grid.Column="2" CornerRadius="22" Background="{DynamicResource KoyNotchCard}" Padding="14">
      <Grid>
        <!-- Odak / Mola: oturum sayısı ve süreler -->
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid" BasedOn="{StaticResource PageVisibility}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPomodoroTab}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <StackPanel>
            <TextBlock Text="{Binding [FocusSessions], Source={x:Static res:Loc.Instance}}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SessionsText}" FontSize="44" FontWeight="SemiBold" Foreground="{DynamicResource KoyNotchAccentFocus}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding DurationsText}" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
          <Button Style="{StaticResource ChipButtonStyle}" Command="{Binding SkipCommand}" VerticalAlignment="Bottom" HorizontalAlignment="Left">
            <TextBlock Text="{Binding [FocusSkip], Source={x:Static res:Loc.Instance}}" FontSize="12" />
          </Button>
        </Grid>

        <!-- Sayaç: süre ve hazır süreler -->
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid" BasedOn="{StaticResource PageVisibility}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCountdownTab}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <StackPanel>
            <TextBlock Text="{Binding [FocusTabTimer], Source={x:Static res:Loc.Instance}}" FontSize="13" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding CanEditCountdown}">
              <Button Style="{StaticResource RoundButtonStyle}" Command="{Binding DecreaseCountdownCommand}"
                      ToolTip="{Binding [FocusShorter], Source={x:Static res:Loc.Instance}}"
                      AutomationProperties.Name="{Binding [FocusShorter], Source={x:Static res:Loc.Instance}}">
                <res:KoyIcon Data="{DynamicResource IconMinus}" Size="16" Foreground="{DynamicResource KoyNotchText}" />
              </Button>
              <TextBlock Text="{Binding CountdownDurationText}" FontSize="30" FontWeight="SemiBold" Width="110" TextAlignment="Center" VerticalAlignment="Center" />
              <Button Style="{StaticResource RoundButtonStyle}" Command="{Binding IncreaseCountdownCommand}"
                      ToolTip="{Binding [FocusLonger], Source={x:Static res:Loc.Instance}}"
                      AutomationProperties.Name="{Binding [FocusLonger], Source={x:Static res:Loc.Instance}}">
                <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource KoyNotchText}" Data="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" />
              </Button>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,14,0,0" IsEnabled="{Binding CanEditCountdown}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:FocusPreset}">
                  <Button Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,6"
                          Command="{Binding DataContext.SetCountdownMinutesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding Minutes}">
                    <TextBlock Text="{Binding Label}" FontSize="12" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>

        <!-- Kronometre: tur düğmesi ve turlar -->
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid" BasedOn="{StaticResource PageVisibility}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsStopwatchTab}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Button Style="{StaticResource ChipButtonStyle}" Command="{Binding LapCommand}" HorizontalAlignment="Left" IsEnabled="{Binding IsRunning}">
            <TextBlock Text="{Binding [FocusLap], Source={x:Static res:Loc.Instance}}" FontSize="12" />
          </Button>
          <TextBlock Grid.Row="1" Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" TextWrapping="Wrap"
                     Text="{Binding [FocusLapsEmpty], Source={x:Static res:Loc.Instance}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasLaps}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding HasLaps, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Laps}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:FocusLapRow}">
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource KoyNotchMuted}" />
                    <TextBlock Grid.Column="1" Text="{Binding Split}" FontSize="12" Foreground="{DynamicResource KoyNotchFocusSoft}" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="12" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
