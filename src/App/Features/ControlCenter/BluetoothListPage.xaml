<UserControl x:Class="Koy.App.Features.ControlCenter.BluetoothListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.ControlCenter"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:radio="clr-namespace:Koy.Core.Radio;assembly=Koy.Core"
             xmlns:bt="clr-namespace:Koy.Core.Bluetooth;assembly=Koy.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ControlCenterViewModel}"
             Foreground="{DynamicResource KoyNotchText}"
             FontSize="12">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="LinkTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource KoyNotchMuted}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource KoyNotchText}" />
          <Setter Property="TextDecorations" Value="Underline" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="BluetoothRowTemplate" DataType="{x:Type local:BluetoothDeviceRowViewModel}">
      <Border x:Name="Card" CornerRadius="12" Background="{DynamicResource KoyNotchControlTile}" Margin="0,0,0,4"
              BorderThickness="1" BorderBrush="Transparent">
        <Grid MinHeight="44">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Ses dışı cihaz (fare, klavye, telefon…): Koy bağlayamaz, satır Windows Bluetooth ayarlarını açar.
               Ses cihazlarında satır tıklanamaz; işlem sağdaki düğmeyle yapılır. -->
          <Button Style="{StaticResource NotchRowButtonStyle}" Padding="10,0"
                  Command="{Binding DataContext.BluetoothDevices.ActivateCommand, RelativeSource={RelativeSource AncestorType=local:BluetoothListPage}}"
                  CommandParameter="{Binding}"
                  IsEnabled="{Binding OpensSettings}"
                  AutomationProperties.Name="{Binding Name}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource KoyNotchControlIconBg}" Margin="0,0,10,0" VerticalAlignment="Center">
                <res:KoyIcon x:Name="DeviceIcon" Data="{DynamicResource IconBluetooth}" Size="15" StrokeWidth="1.8"
                             Foreground="{DynamicResource KoyNotchControlBattery}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="250" HorizontalAlignment="Left" />
                <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="10.5" Foreground="{DynamicResource KoyNotchMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                <TextBlock Text="{Binding HintText}" FontSize="9.5" Foreground="{DynamicResource KoyNotchDim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                           Visibility="{Binding OpensSettings, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </Grid>
          </Button>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="{Binding BatteryText}" FontSize="11.5" Foreground="{DynamicResource KoyNotchControlBattery}" VerticalAlignment="Center" Margin="0,0,8,0"
                       Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}" />
            <Button Style="{StaticResource NotchPillButtonStyle}" Content="{Binding ActionText}" IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBoolConverter.Instance}}"
                    Command="{Binding DataContext.BluetoothDevices.ActivateCommand, RelativeSource={RelativeSource AncestorType=local:BluetoothListPage}}"
                    CommandParameter="{Binding}"
                    Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static bt:BluetoothDeviceKind.Headphones}">
          <Setter TargetName="DeviceIcon" Property="Data" Value="{DynamicResource IconHeadphones}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static bt:BluetoothDeviceKind.Speaker}">
          <Setter TargetName="DeviceIcon" Property="Data" Value="{DynamicResource IconSpeaker}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static bt:BluetoothDeviceKind.Mouse}">
          <Setter TargetName="DeviceIcon" Property="Data" Value="{DynamicResource IconMouse}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static bt:BluetoothDeviceKind.Keyboard}">
          <Setter TargetName="DeviceIcon" Property="Data" Value="{DynamicResource IconKeyboard}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static bt:BluetoothDeviceKind.Phone}">
          <Setter TargetName="DeviceIcon" Property="Data" Value="{DynamicResource IconSmartphone}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static bt:BluetoothDeviceKind.Tablet}">
          <Setter TargetName="DeviceIcon" Property="Data" Value="{DynamicResource IconTablet}" />
        </DataTrigger>
        <!-- Bağlı cihaz: mavi çerçeve -->
        <DataTrigger Binding="{Binding IsConnected}" Value="True">
          <Setter TargetName="Card" Property="Background" Value="{DynamicResource KoyNotchControlCard}" />
          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource KoyNotchAccentControl}" />
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource KoyNotchControlSoft}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ErrorText, Converter={x:Static local:HasTextConverter.Instance}}" Value="True">
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource KoyNotchRowError}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
      <RowDefinition Height="22" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource NotchRowButtonStyle}" Width="32" Height="32" Command="{Binding BackCommand}"
              ToolTip="{x:Static res:Strings.ControlBack}" AutomationProperties.Name="{x:Static res:Strings.ControlBack}">
        <res:KoyIcon Data="{DynamicResource IconChevronLeft}" Size="16" StrokeWidth="2.2" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource KoyNotchText}" />
      </Button>
      <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Bluetooth}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
      <CheckBox Grid.Column="2" Style="{StaticResource NotchSwitchStyle}" Margin="0,0,4,0"
                IsChecked="{Binding Bluetooth.IsOn, Mode=OneWay}"
                IsEnabled="{Binding Bluetooth.IsUnavailable, Converter={x:Static local:InverseBoolConverter.Instance}}"
                Command="{Binding ActivateRadioCommand}" CommandParameter="{x:Static radio:RadioKind.Bluetooth}"
                AutomationProperties.Name="{x:Static res:Strings.Bluetooth}" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,8,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding ShowBluetoothList, Converter={StaticResource BoolToVis}}">
        <ItemsControl ItemsSource="{Binding BluetoothDevices.Devices}" ItemTemplate="{StaticResource BluetoothRowTemplate}" Focusable="False" Margin="0,0,4,0" />
      </ScrollViewer>

      <Border CornerRadius="12" Background="{DynamicResource KoyNotchControlTile}" Padding="14,10" VerticalAlignment="Top"
              Visibility="{Binding ShowBluetoothMessage, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding BluetoothMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource KoyNotchControlSoft}" />
      </Border>
    </Grid>

    <Button Grid.Row="2" Style="{StaticResource NotchPlainButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,0"
            Click="MoreSettings_Click">
      <TextBlock Text="{x:Static res:Strings.BluetoothMoreSettings}" Style="{StaticResource LinkTextStyle}" />
    </Button>
  </Grid>
</UserControl>
