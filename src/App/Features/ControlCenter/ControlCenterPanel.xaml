<UserControl x:Class="Koy.App.Features.ControlCenter.ControlCenterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.ControlCenter"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:radio="clr-namespace:Koy.Core.Radio;assembly=Koy.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ControlCenterViewModel}"
             Foreground="{DynamicResource KoyNotchText}"
             FontSize="12">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Döşeme Düğmesi Stili (Tile Button) -->
    <Style x:Key="TileButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource KoyNotchControlTile}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TileBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="18"
                    Padding="12,0">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TileBorder" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="TileBorder" Property="Opacity" Value="0.75" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- Açık radyo döşemesi sayfa renginde (mavi) dolar; Content bir RadioTileViewModel iken geçerli -->
        <DataTrigger Binding="{Binding Content.IsOn, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource KoyNotchAccentControl}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Döşemenin sağındaki ok: Windows'taki ağ / cihaz sayfasını açar -->
    <Style x:Key="TileChevronStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ChevronBorder" Background="Transparent" CornerRadius="6" Width="18" Height="30">
              <Path Width="5" Height="9" Stretch="Uniform" Data="M 0,0 L 4,4 L 0,8"
                    Stroke="#99FFFFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChevronBorder" Property="Background" Value="#26FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Wi-Fi / Bluetooth döşemesinin içeriği: simge, ad ve durum (Açık, Kapalı, Bulunamadı, İzin yok...) -->
    <DataTemplate x:Key="RadioTileTemplate" DataType="{x:Type local:RadioTileViewModel}">
      <Grid Margin="0,0,16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="IconBorder" Width="30" Height="30" CornerRadius="10" VerticalAlignment="Center" Background="#20FFFFFF">
          <Path x:Name="Icon" Width="13" Height="13" Stretch="Uniform"
                Stroke="#FFFFFFFF" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
          <TextBlock x:Name="Title" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource KoyNotchText}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static radio:RadioKind.WiFi}">
          <Setter TargetName="Title" Property="Text" Value="{x:Static res:Strings.WiFi}" />
          <Setter TargetName="Icon" Property="Data" Value="M 12,18 A 1.5,1.5 0 1 1 12,15 A 1.5,1.5 0 0 1 12,18 M 7.05,12.05 A 7,7 0 0 1 16.95,12.05 M 3.5,8.5 A 12,12 0 0 1 20.5,8.5" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static radio:RadioKind.Bluetooth}">
          <Setter TargetName="Title" Property="Text" Value="{x:Static res:Strings.Bluetooth}" />
          <Setter TargetName="Icon" Property="Width" Value="11" />
          <Setter TargetName="Icon" Property="Data" Value="M 7,2 L 7,22 L 13,17 L 2,8 L 13,7 L 7,2 Z M 7,7 L 10,9.5 L 7,12 Z M 7,12 L 10,14.5 L 7,17 Z" />
        </DataTrigger>
        <!-- Açık: mavi zeminde koyu yazı (tasarımdaki gibi) -->
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter TargetName="IconBorder" Property="Background" Value="#26000000" />
          <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource KoyNotchSurface}" />
          <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource KoyNotchSurface}" />
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource KoyNotchSurface}" />
        </DataTrigger>
        <!-- Değiştirilemeyen radyo soluk görünür; durum satırı nedenini sarıyla yazar -->
        <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
          <Setter TargetName="IconBorder" Property="Opacity" Value="0.5" />
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource KoyStatusWarn}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Kaydırıcı (Slider) Modern Minimal Stili -->
    <Style x:Key="ModernSliderStyle" TargetType="Slider">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center" Height="22">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" CornerRadius="4,0,0,4" Height="8" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{DynamicResource KoyNotchControlTrack}" CornerRadius="0,4,4,0" Height="8" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource KoyNotchText}" Stroke="#33000000" StrokeThickness="1" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="62" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Üst satır: Wi-Fi, Bluetooth, Rahatsız Etme. Döşemeler sürüklenerek yeniden sıralanır (sıra ControlCenterLayout'a
         yazılır); konumları kod arkasında yayla kayar. -->
    <Grid Grid.Row="0" x:Name="TilesHost" Height="62" Background="Transparent"
          SizeChanged="TilesHost_SizeChanged"
          PreviewMouseLeftButtonDown="TilesHost_PreviewMouseLeftButtonDown"
          PreviewMouseMove="TilesHost_PreviewMouseMove"
          PreviewMouseLeftButtonUp="TilesHost_PreviewMouseLeftButtonUp"
          LostMouseCapture="TilesHost_LostMouseCapture">

      <!-- Wi-Fi: tıklayınca açar/kapatır; ok, Windows'taki ağ listesini açar -->
      <Grid x:Name="TileWifi" Tag="wifi" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Button Style="{StaticResource TileButtonStyle}" Height="62"
                CommandParameter="{x:Static radio:RadioKind.WiFi}"
                Command="{Binding ActivateRadioCommand}"
                ToolTip="{Binding WiFi.ToolTip}"
                Content="{Binding WiFi}"
                ContentTemplate="{StaticResource RadioTileTemplate}" />
        <Button Style="{StaticResource TileChevronStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                CommandParameter="{x:Static radio:RadioKind.WiFi}"
                Command="{Binding OpenRadioSettingsCommand}"
                ToolTip="{x:Static res:Strings.OpenInSettings}" />
      </Grid>

      <!-- Bluetooth: tıklayınca açar/kapatır; ok, Windows'taki cihaz listesini açar -->
      <Grid x:Name="TileBluetooth" Tag="bluetooth" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Button Style="{StaticResource TileButtonStyle}" Height="62"
                CommandParameter="{x:Static radio:RadioKind.Bluetooth}"
                Command="{Binding ActivateRadioCommand}"
                ToolTip="{Binding Bluetooth.ToolTip}"
                Content="{Binding Bluetooth}"
                ContentTemplate="{StaticResource RadioTileTemplate}" />
        <Button Style="{StaticResource TileChevronStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                CommandParameter="{x:Static radio:RadioKind.Bluetooth}"
                Command="{Binding OpenRadioSettingsCommand}"
                ToolTip="{x:Static res:Strings.OpenInSettings}" />
      </Grid>

      <!-- Rahatsız Etme: resmi açma/kapama ya da güvenilir okuma API'si yok; uydurma durum yerine
           Windows'taki ayarı açan kısayol olarak gösterilir. -->
      <Button x:Name="TileDoNotDisturb" Tag="donotdisturb" HorizontalAlignment="Left" VerticalAlignment="Top"
              Style="{StaticResource TileButtonStyle}" Height="62"
              Command="{Binding OpenDoNotDisturbSettingsCommand}"
              ToolTip="{x:Static res:Strings.OpenInSettings}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="30" Height="30" CornerRadius="10" VerticalAlignment="Center" Background="#20FFFFFF">
            <Path Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource KoyNotchText}"
                  Data="M 12 3 A 9 9 0 1 0 21 12 A 7 7 0 0 1 12 3 Z"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock Text="{x:Static res:Strings.DoNotDisturb}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource KoyNotchText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Static res:Strings.OpenInSettings}" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Button>
    </Grid>

    <!-- Ses ve parlaklık -->
    <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="18" Background="{DynamicResource KoyNotchControlCard}" Padding="14,12">
      <StackPanel VerticalAlignment="Center">
        <!-- Ses: etikete tıklamak sessize alır / açar -->
        <Grid Height="30">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="40" />
          </Grid.ColumnDefinitions>
          <Button Command="{Binding ToggleMuteCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"
                  FocusVisualStyle="{x:Null}" ToolTip="{Binding [ControlVolume], Source={x:Static res:Loc.Instance}}" AutomationProperties.Name="{Binding [ControlVolume], Source={x:Static res:Loc.Instance}}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <StackPanel Orientation="Horizontal" Background="Transparent">
                  <Grid Width="14" Height="14" Margin="0,0,8,0">
                    <Path Stretch="Uniform" Fill="{DynamicResource KoyNotchControlSoft}"
                          Data="M 3,6 L 6,6 L 11,2 L 11,16 L 6,12 L 3,12 Z M 13,5 A 5,5 0 0 1 13,13 M 15,3 A 8,8 0 0 1 15,15">
                      <Path.Style>
                        <Style TargetType="Path">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                    <Path Stretch="Uniform" Fill="#EF4444" Stroke="#EF4444" StrokeThickness="1.2"
                          Data="M 3,6 L 6,6 L 11,2 L 11,16 L 6,12 L 3,12 Z M 14,7 L 18,11 M 18,7 L 14,11">
                      <Path.Style>
                        <Style TargetType="Path">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                  </Grid>
                  <TextBlock Text="{Binding [ControlVolume], Source={x:Static res:Loc.Instance}}" Foreground="{DynamicResource KoyNotchControlSoft}" VerticalAlignment="Center" />
                </StackPanel>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource ModernSliderStyle}"
                  Foreground="{DynamicResource KoyNotchText}"
                  Minimum="0" Maximum="100"
                  Value="{Binding VolumePercent, Mode=OneWay}"
                  ValueChanged="VolumeSlider_ValueChanged"
                  Margin="6,0" />
          <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat='%{0}'}"
                     FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <!-- Parlaklık (yalnız destekleniyorsa görünür) -->
        <Grid Height="30" Margin="0,10,0,0" Visibility="{Binding IsBrightnessSupported, Converter={StaticResource BoolToVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="40" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <res:KoyIcon Data="{DynamicResource IconSun}" Size="14" Foreground="{DynamicResource KoyNotchBrightness}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding [ControlBrightness], Source={x:Static res:Loc.Instance}}" Foreground="{DynamicResource KoyNotchControlSoft}" VerticalAlignment="Center" />
          </StackPanel>
          <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource ModernSliderStyle}"
                  Foreground="{DynamicResource KoyNotchBrightness}"
                  Minimum="0" Maximum="100"
                  Value="{Binding Brightness, Mode=OneWay}"
                  ValueChanged="BrightnessSlider_ValueChanged"
                  Margin="6,0" />
          <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat='%{0}'}"
                     FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
