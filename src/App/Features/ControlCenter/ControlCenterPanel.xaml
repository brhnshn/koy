<UserControl x:Class="Koy.App.Features.ControlCenter.ControlCenterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.ControlCenter"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:radio="clr-namespace:Koy.Core.Radio;assembly=Koy.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ControlCenterViewModel}"
             Foreground="{StaticResource NotchForeground}"
             FontSize="12">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Döşeme Düğmesi Stili (Tile Button) -->
    <Style x:Key="TileButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="BorderBrush" Value="#25FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TileBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="8,6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TileBorder" Property="Background" Value="#2EFFFFFF" />
                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#45FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="TileBorder" Property="Background" Value="#40FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Döşemenin sağındaki ok: Windows'taki ağ / cihaz sayfasını açar -->
    <Style x:Key="TileChevronStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ChevronBorder" Background="Transparent" CornerRadius="6" Width="18" Height="30">
              <Path Width="5" Height="9" Stretch="Uniform" Data="M 0,0 L 4,4 L 0,8"
                    Stroke="#99FFFFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChevronBorder" Property="Background" Value="#26FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Wi-Fi / Bluetooth döşemesinin içeriği: simge, ad ve durum (Açık, Kapalı, Bulunamadı, İzin yok...) -->
    <DataTemplate x:Key="RadioTileTemplate" DataType="{x:Type local:RadioTileViewModel}">
      <Grid Margin="0,0,14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="IconBorder" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Center" Background="#20FFFFFF">
          <Path x:Name="Icon" Width="13" Height="13" Stretch="Uniform"
                Stroke="#FFFFFFFF" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
          <TextBlock x:Name="Title" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NotchForeground}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="9" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static radio:RadioKind.WiFi}">
          <Setter TargetName="Title" Property="Text" Value="{x:Static res:Strings.WiFi}" />
          <Setter TargetName="Icon" Property="Fill" Value="#FFFFFFFF" />
          <Setter TargetName="Icon" Property="Data" Value="M 12,18 A 1.5,1.5 0 1 1 12,15 A 1.5,1.5 0 0 1 12,18 M 7.05,12.05 A 7,7 0 0 1 16.95,12.05 M 3.5,8.5 A 12,12 0 0 1 20.5,8.5" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static radio:RadioKind.Bluetooth}">
          <Setter TargetName="Title" Property="Text" Value="{x:Static res:Strings.Bluetooth}" />
          <Setter TargetName="Icon" Property="Width" Value="11" />
          <Setter TargetName="Icon" Property="Data" Value="M 7,2 L 7,22 L 13,17 L 2,8 L 13,7 L 7,2 Z M 7,7 L 10,9.5 L 7,12 Z M 7,12 L 10,14.5 L 7,17 Z" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter TargetName="IconBorder" Property="Background" Value="{DynamicResource KoyAccent}" />
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource KoyAccentText}" />
        </DataTrigger>
        <!-- Değiştirilemeyen radyo soluk görünür; durum satırı nedenini sarıyla yazar -->
        <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
          <Setter TargetName="IconBorder" Property="Opacity" Value="0.5" />
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource KoyStatusWarn}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Kaydırıcı (Slider) Modern Minimal Stili -->
    <Style x:Key="ModernSliderStyle" TargetType="Slider">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center" Height="22">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="#45FFFFFF" CornerRadius="5,0,0,5" Height="8" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="#1AFFFFFF" CornerRadius="0,5,5,0" Height="8" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="14" Height="14" Fill="#FFFFFFFF" Stroke="#33000000" StrokeThickness="1" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="16,8,16,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Üst Satır: 3 Döşeme (Wi-Fi, Bluetooth, Rahatsız Etme) -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 1. Wi-Fi Döşemesi: tıklayınca açar/kapatır; ok, Windows'taki ağ listesini açar -->
      <Grid Grid.Column="0">
        <Button Style="{StaticResource TileButtonStyle}" Height="46"
                CommandParameter="{x:Static radio:RadioKind.WiFi}"
                Command="{Binding ActivateRadioCommand}"
                ToolTip="{Binding WiFi.ToolTip}"
                Content="{Binding WiFi}"
                ContentTemplate="{StaticResource RadioTileTemplate}" />
        <Button Style="{StaticResource TileChevronStyle}" HorizontalAlignment="Right" Margin="0,0,3,0"
                CommandParameter="{x:Static radio:RadioKind.WiFi}"
                Command="{Binding OpenRadioSettingsCommand}"
                ToolTip="{x:Static res:Strings.OpenInSettings}" />
      </Grid>

      <!-- 2. Bluetooth Döşemesi: tıklayınca açar/kapatır; ok, Windows'taki cihaz listesini açar -->
      <Grid Grid.Column="2">
        <Button Style="{StaticResource TileButtonStyle}" Height="46"
                CommandParameter="{x:Static radio:RadioKind.Bluetooth}"
                Command="{Binding ActivateRadioCommand}"
                ToolTip="{Binding Bluetooth.ToolTip}"
                Content="{Binding Bluetooth}"
                ContentTemplate="{StaticResource RadioTileTemplate}" />
        <Button Style="{StaticResource TileChevronStyle}" HorizontalAlignment="Right" Margin="0,0,3,0"
                CommandParameter="{x:Static radio:RadioKind.Bluetooth}"
                Command="{Binding OpenRadioSettingsCommand}"
                ToolTip="{x:Static res:Strings.OpenInSettings}" />
      </Grid>

      <!-- 3. Rahatsız Etme: resmi açma/kapama ya da güvenilir okuma API'si yok; uydurma durum yerine
           Windows'taki ayarı açan kısayol olarak gösterilir. -->
      <Button Grid.Column="4" Style="{StaticResource TileButtonStyle}" Height="46"
              Command="{Binding OpenDoNotDisturbSettingsCommand}"
              ToolTip="{x:Static res:Strings.OpenInSettings}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <!-- Hilal Ay İkonu -->
          <Border Width="26" Height="26" CornerRadius="13" VerticalAlignment="Center" Background="#20FFFFFF">
            <Path Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFFFF"
                  Data="M 12 3 A 9 9 0 1 0 21 12 A 7 7 0 0 1 12 3 Z"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock Text="{x:Static res:Strings.DoNotDisturb}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource NotchForeground}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Static res:Strings.OpenInSettings}" FontSize="9" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <Path Grid.Column="2" Width="5" Height="9" Stretch="Uniform" Data="M 0,0 L 4,4 L 0,8" Margin="4,0,2,0"
                Stroke="#99FFFFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                VerticalAlignment="Center" />
        </Grid>
      </Button>
    </Grid>

    <!-- Alt Satır: Kaydırıcılar (Ses Seviyesi + Ekran Parlaklığı) -->
    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
      <!-- Ses Kaydırıcısı -->
      <Grid Height="26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="26" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>

        <!-- Ses / Sessiz Butonu -->
        <Button Grid.Column="0" Command="{Binding ToggleMuteCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2">
          <Grid>
            <!-- Normal Hoparlör -->
            <Path Width="14" Height="14" Stretch="Uniform" Fill="#DDFFFFFF"
                  Data="M 3,6 L 6,6 L 11,2 L 11,16 L 6,12 L 3,12 Z M 13,5 A 5,5 0 0 1 13,13 M 15,3 A 8,8 0 0 1 15,15">
              <Path.Style>
                <Style TargetType="Path">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>

            <!-- Sessiz (Mute) İkonu -->
            <Path Width="14" Height="14" Stretch="Uniform" Fill="#EF4444"
                  Data="M 3,6 L 6,6 L 11,2 L 11,16 L 6,12 L 3,12 Z M 14,7 L 18,11 M 18,7 L 14,11"
                  Stroke="#EF4444" StrokeThickness="1.2">
              <Path.Style>
                <Style TargetType="Path">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
          </Grid>
        </Button>

        <!-- Ses Slider -->
        <Slider x:Name="VolumeSlider"
                Grid.Column="1"
                Style="{StaticResource ModernSliderStyle}"
                Minimum="0" Maximum="100"
                Value="{Binding VolumePercent, Mode=OneWay}"
                ValueChanged="VolumeSlider_ValueChanged"
                Margin="6,0" />

        <!-- Yüzde Metni -->
        <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat='%{0}'}"
                   FontSize="10" Foreground="#99FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <!-- Parlaklık Kaydırıcısı (Yalnız destekleniyorsa görünür) -->
      <Grid Height="26" Visibility="{Binding IsBrightnessSupported, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="26" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>

        <!-- Güneş İkonu -->
        <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Fill="#F59E0B"
              Data="M 12,7 A 5,5 0 1 1 7,12 A 5,5 0 0 1 12,7 M 12,1 L 12,4 M 12,20 L 12,23 M 4.22,4.22 L 6.34,6.34 M 17.66,17.66 L 19.78,19.78 M 1,12 L 4,12 M 20,12 L 23,12 M 4.22,19.78 L 6.34,17.66 M 17.66,6.34 L 19.78,4.22"
              Stroke="#F59E0B" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Parlaklık Slider -->
        <Slider x:Name="BrightnessSlider"
                Grid.Column="1"
                Style="{StaticResource ModernSliderStyle}"
                Minimum="0" Maximum="100"
                Value="{Binding Brightness, Mode=OneWay}"
                ValueChanged="BrightnessSlider_ValueChanged"
                Margin="6,0" />

        <!-- Yüzde Metni -->
        <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat='%{0}'}"
                   FontSize="10" Foreground="#99FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
