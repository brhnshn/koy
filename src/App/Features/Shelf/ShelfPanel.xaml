<UserControl x:Class="Koy.App.Features.Shelf.ShelfPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Shelf"
             xmlns:shelf="clr-namespace:Koy.Core.Shelf;assembly=Koy.Core"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ShelfViewModel}"
             Foreground="{DynamicResource KoyNotchText}"
             FontSize="11"
             AllowDrop="True"
             Drop="ShelfPanel_Drop"
             DragOver="ShelfPanel_DragOver">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:ShelfBadgeConverter x:Key="BadgeConverter" />

    <Style x:Key="ShelfChipStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource KoyNotchShelfChipText}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Height="28" CornerRadius="14" Background="{DynamicResource KoyNotchShelfChip}" Padding="12,0">
              <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="11" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border CornerRadius="22" Background="{DynamicResource KoyNotchShelfCard}" Padding="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Başlık: Raf · 3 öğe, Temizle -->
      <Grid Grid.Row="0" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center">
          <Run Text="{x:Static res:Strings.Shelf}" FontWeight="SemiBold" FontSize="13" />
          <Run Text="{Binding CountText, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource KoyNotchShelfSoft}" FontSize="12" />
        </TextBlock>
        <Button Grid.Column="1" Style="{StaticResource ShelfChipStyle}" Command="{Binding ClearAllCommand}"
                Visibility="{Binding IsNotEmpty, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding [ShelfClear], Source={x:Static res:Loc.Instance}}" />
        </Button>
      </Grid>

      <!-- Öğeler (sığmazsa alta sarar) ve sağda sabit bırakma kutusu. Öğeyi sürükleyip başka uygulamaya bırakabilirsin; çift tıklayınca açılır. -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type shelf:ShelfItem}">
            <Border Width="120" Height="78" Margin="0,0,10,8" CornerRadius="16" Background="{DynamicResource KoyNotchSurface}"
                    Padding="8" Cursor="Hand" ToolTip="{Binding PathOrContent}"
                    MouseMove="Item_MouseMove" MouseLeftButtonDown="Item_MouseLeftButtonDown">
              <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Border Width="34" Height="40" CornerRadius="7" HorizontalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource KoyNotchTextSecondary}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Kind}" Value="{x:Static shelf:ShelfItemKind.Directory}">
                            <Setter Property="Background" Value="{DynamicResource KoyNotchShelfSoft}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="{x:Static shelf:ShelfItemKind.Text}">
                            <Setter Property="Background" Value="{DynamicResource KoyNotchControlSoft}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Converter={StaticResource BadgeConverter}}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource KoyNotchSurface}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                  </Border>
                  <TextBlock Text="{Binding DisplayName}" FontSize="11" Margin="0,8,0,0" TextAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxWidth="108" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="18" Height="18" Cursor="Hand" FocusVisualStyle="{x:Null}"
                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Id}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bg" CornerRadius="9" Background="Transparent">
                        <res:KoyIcon Data="{DynamicResource IconX}" Size="10" Foreground="{DynamicResource KoyNotchMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bg" Property="Background" Value="{DynamicResource KoyNotchHover}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

        </ScrollViewer>
        <Grid Grid.Column="1">
      <!-- Bırakma kutusu -->
        <Grid Width="120" Height="78" VerticalAlignment="Top">
          <Rectangle RadiusX="16" RadiusY="16" Stroke="{DynamicResource KoyNotchShelfDash}" StrokeThickness="1.5" StrokeDashArray="3 3" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <res:KoyIcon Data="{DynamicResource IconDownload}" Size="20" Foreground="{DynamicResource KoyNotchShelfSoft}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding [ShelfDropHere], Source={x:Static res:Loc.Instance}}" FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource KoyNotchShelfSoft}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
          </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
