<Window x:Class="Koy.App.Features.Notch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koy.App.Features.Notch"
        xmlns:music="clr-namespace:Koy.App.Features.Music"
        xmlns:core="clr-namespace:Koy.Core.Notch;assembly=Koy.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:NotchViewModel}"
        Title="Koy"
        Width="500" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
    <!-- Sabit tuval üzerinde yay animasyonlu özel çentik şekli -->
    <local:NotchShape x:Name="Notch"
                      Width="200" Height="34"
                      CornerRadius="24" EarRadius="12"
                      Background="{StaticResource NotchBackground}"
                      MouseEnter="Notch_MouseEnter"
                      MouseLeave="Notch_MouseLeave"
                      MouseLeftButtonDown="Notch_MouseLeftButtonDown"
                      MouseWheel="Notch_MouseWheel"
                      Cursor="Hand">
      <local:NotchShape.RenderTransform>
        <TranslateTransform x:Name="NotchTranslate" Y="0" />
      </local:NotchShape.RenderTransform>
      <local:NotchShape.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Çıkış" Command="{Binding QuitCommand}" />
        </ContextMenu>
      </local:NotchShape.ContextMenu>

      <Grid Margin="12,0,12,0">
        <!-- 1. Collapsed Durumu -->
        <Grid x:Name="CollapsedView">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:NotchState.Collapsed}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>

          <!-- Normal boş durum (müzik yokken) -->
          <TextBlock Text="{Binding Title}"
                     Foreground="{StaticResource NotchForeground}"
                     FontSize="12"
                     FontWeight="Medium"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Music.HasTrack}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <!-- Müzik çalarken Collapsed çentik (kapak + isim + statik ses dalgası) -->
          <Grid VerticalAlignment="Center">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Music.HasTrack}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sol: Küçük kapak resmi (18x18) veya nota ikonu -->
            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" Background="#20FFFFFF" ClipToBounds="True">
              <Grid>
                <Path Width="10" Height="10" Stretch="Uniform" Fill="#60FFFFFF"
                      Data="M 12,3 L 6,5 L 6,11 A 2.5,2.5 0 1 1 3.5,8.5 L 5,8.5 L 5,4 L 12,2 Z" />
                <Image Source="{Binding Music.Thumbnail}" Stretch="UniformToFill" />
              </Grid>
            </Border>

            <!-- Orta: Şarkı adı veya Koy -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Music.Title}"
                       Foreground="{StaticResource NotchForeground}"
                       FontSize="11"
                       Margin="8,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />

            <!-- Sağ: Hareketsiz (statik) ses dalgası vektör ikonu (%0 CPU) -->
            <Canvas Grid.Column="2" Width="14" Height="12" VerticalAlignment="Center" Opacity="0.8">
              <Line X1="2" Y1="4" X2="2" Y2="10" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Line X1="5" Y1="2" X2="5" Y2="12" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Line X1="8" Y1="5" X2="8" Y2="9" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Line X1="11" Y1="3" X2="11" Y2="11" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Grid>
        </Grid>

        <!-- 2. Peek Durumu -->
        <Grid x:Name="PeekView" VerticalAlignment="Center">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:NotchState.Peek}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Sol: 24x24 kapak -->
          <Border Grid.Column="0" Width="24" Height="24" CornerRadius="5" Background="#20FFFFFF" ClipToBounds="True">
            <Grid>
              <Path Width="12" Height="12" Stretch="Uniform" Fill="#60FFFFFF"
                    Data="M 12,3 L 6,5 L 6,11 A 2.5,2.5 0 1 1 3.5,8.5 L 5,8.5 L 5,4 L 12,2 Z" />
              <Image Source="{Binding Music.Thumbnail}" Stretch="UniformToFill" />
            </Grid>
          </Border>

          <!-- Orta: Şarkı adı ve sanatçı -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
            <TextBlock Text="{Binding Music.Title}"
                       Foreground="{StaticResource NotchForeground}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock Text="{Binding Music.Artist}"
                       Foreground="#99FFFFFF"
                       FontSize="9"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
          </StackPanel>

          <!-- Sağ: Oynatma göstergesi -->
          <Canvas Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center" Opacity="0.9">
            <Line X1="2" Y1="3" X2="2" Y2="11" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line X1="6" Y1="1" X2="6" Y2="13" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line X1="10" Y1="4" X2="10" Y2="10" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Canvas>
        </Grid>

        <!-- 3. Expanded Durumu -->
        <Grid x:Name="ExpandedView">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:NotchState.Expanded}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>

          <!-- Panel Seçici / İçerik (Şu anda MusicPanel) -->
          <music:MusicPanel DataContext="{Binding Music}" />
        </Grid>
      </Grid>
    </local:NotchShape>
  </Grid>
</Window>
