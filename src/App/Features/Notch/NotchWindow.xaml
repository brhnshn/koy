<Window x:Class="Koy.App.Features.Notch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koy.App.Features.Notch"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:NotchViewModel}"
        Title="Koy"
        Width="500" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False">
  <!--
    Sabit tuval: pencere en büyük panel boyutunda sabit durur, yalnız içindeki şekil yaylanır.
    Window.Width/Height her karede değişirse saydam pencere titrer. Tamamen saydam alanlar
    tıklamayı alttaki pencereye geçirir; yalnız hap tıklanır. Panel büyürse bu boyutu güncelle.
  -->
  <Border x:Name="Pill"
          Width="200" Height="34"
          HorizontalAlignment="Center" VerticalAlignment="Top"
          Background="{StaticResource NotchBackground}"
          CornerRadius="0,0,18,18"
          MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Çıkış" Command="{Binding QuitCommand}" />
      </ContextMenu>
    </Border.ContextMenu>
    <TextBlock Text="{Binding Title}"
               Foreground="{StaticResource NotchForeground}"
               FontSize="12"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Border>
</Window>
