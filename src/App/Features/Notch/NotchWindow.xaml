<Window x:Class="Koy.App.Features.Notch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koy.App.Features.Notch"
        xmlns:osd="clr-namespace:Koy.App.Features.Notch.OSD"
        xmlns:music="clr-namespace:Koy.App.Features.Music"
        xmlns:cc="clr-namespace:Koy.App.Features.ControlCenter"
        xmlns:status="clr-namespace:Koy.App.Features.Status"
        xmlns:cal="clr-namespace:Koy.App.Features.Calendar"
        xmlns:shelf="clr-namespace:Koy.App.Features.Shelf"
        xmlns:res="clr-namespace:Koy.App.Resources"
        xmlns:core="clr-namespace:Koy.Core.Notch;assembly=Koy.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:NotchViewModel}"
        Title="Koy"
        Width="500" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        AllowDrop="True"
        DragEnter="Notch_DragEnter"
        DragOver="Notch_DragOver"
        Drop="Notch_Drop">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
    <!-- Sabit tuval üzerinde yay animasyonlu özel çentik şekli -->
    <local:NotchShape x:Name="Notch"
                      Width="236" Height="34"
                      CornerRadius="18" EarRadius="12"
                      Background="#0A0A0B"
                      MouseEnter="Notch_MouseEnter"
                      MouseLeave="Notch_MouseLeave"
                      MouseLeftButtonDown="Notch_MouseLeftButtonDown"
                      MouseWheel="Notch_MouseWheel"
                      AllowDrop="True"
                      DragEnter="Notch_DragEnter"
                      DragOver="Notch_DragOver"
                      Drop="Notch_Drop"
                      Cursor="Hand">
      <local:NotchShape.RenderTransform>
        <TranslateTransform x:Name="NotchTranslate" Y="0" />
      </local:NotchShape.RenderTransform>
      <local:NotchShape.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{x:Static res:Strings.Settings}" Command="{Binding OpenSettingsCommand}" />
        </ContextMenu>
      </local:NotchShape.ContextMenu>

      <Grid>
        <!-- 1. Collapsed Durumu (236x34 px, köşe yuvarlaklığı 0 0 18 18, arka plan #0A0A0B) -->
        <Grid x:Name="CollapsedView">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}" Value="{x:Static core:NotchState.Collapsed}" />
                    <Condition Binding="{Binding Osd.IsActive}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>

          <!-- 1a. Boşta: Saat ve Pil (Solda 13px saat, sağda 22x11 pil göstergesi) -->
          <Grid x:Name="IdleStateView" VerticalAlignment="Center" Margin="22,0,22,0">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMusicPlaying}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sol: Saat (HH:mm, 13px, font-weight 600, foreground #F4F4F5) -->
            <TextBlock Grid.Column="0"
                       Text="{Binding ClockTime}"
                       Foreground="#F4F4F5"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <!-- Sağ: Pil Göstergesi (22x11 px dış gövde #F4F4F5, seviye #4ADE80, terminal uç 2x5) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="22" Height="11" BorderThickness="1.5" BorderBrush="#F4F4F5" CornerRadius="3" Padding="1" Background="Transparent">
                <Border HorizontalAlignment="Left" Width="{Binding BatteryFillWidth}" Height="6" Background="#4ADE80" CornerRadius="1" />
              </Border>
              <Border Width="2" Height="5" Background="#F4F4F5" CornerRadius="1" Margin="2,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <!-- 1b. Müzik Çalarken: Kapak ve 4 çubuklu dalga (30px yan marjinler kavisli kulaklardan ve alt köşelerden tam korur) -->
          <Grid x:Name="MusicStateView" VerticalAlignment="Center" Margin="30,0,30,0">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMusicPlaying}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sol: 22x22 albüm kapağı (5px köşe yuvarlama) -->
            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5" Background="#22C55E" ClipToBounds="True">
              <Grid>
                <Path Width="11" Height="11" Stretch="Uniform" Fill="#60FFFFFF"
                      Data="M 12,3 L 6,5 L 6,11 A 2.5,2.5 0 1 1 3.5,8.5 L 5,8.5 L 5,4 L 12,2 Z" />
                <Image Source="{Binding Music.Thumbnail}" Stretch="UniformToFill" />
              </Grid>
            </Border>

            <!-- Orta: Şarkı adı -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Music.Title}"
                       Foreground="#F4F4F5"
                       FontSize="11"
                       FontWeight="Medium"
                       Margin="8,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />

            <!-- Sağ: 4 çubuklu hareketsiz dalga (yükseklik 14px, çubuklar: 8, 14, 10, 5 px, genişlik 3px, boşluk 2px, dolgu #4ADE80, %0 CPU) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="14">
              <Border Width="3" Height="8" Background="#4ADE80" CornerRadius="1" VerticalAlignment="Bottom" />
              <Border Width="3" Height="14" Background="#4ADE80" CornerRadius="1" Margin="2,0,0,0" VerticalAlignment="Bottom" />
              <Border Width="3" Height="10" Background="#4ADE80" CornerRadius="1" Margin="2,0,0,0" VerticalAlignment="Bottom" />
              <Border Width="3" Height="5" Background="#4ADE80" CornerRadius="1" Margin="2,0,0,0" VerticalAlignment="Bottom" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- OSD Göstergesi (Ses & Parlaklık — 260x40 px, köşe yuvarlaklığı 20, 1.5 sn auto-dismiss) -->
        <Grid x:Name="OsdContainerView" VerticalAlignment="Center">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Osd.IsActive}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <osd:OsdView DataContext="{Binding Osd}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- 2. Peek Durumu -->
        <Grid x:Name="PeekView" VerticalAlignment="Center" Margin="12,0,12,0">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}" Value="{x:Static core:NotchState.Peek}" />
                    <Condition Binding="{Binding Osd.IsActive}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Sol: 24x24 kapak -->
          <Border Grid.Column="0" Width="24" Height="24" CornerRadius="5" Background="#20FFFFFF" ClipToBounds="True">
            <Grid>
              <Path Width="12" Height="12" Stretch="Uniform" Fill="#60FFFFFF"
                    Data="M 12,3 L 6,5 L 6,11 A 2.5,2.5 0 1 1 3.5,8.5 L 5,8.5 L 5,4 L 12,2 Z" />
              <Image Source="{Binding Music.Thumbnail}" Stretch="UniformToFill" />
            </Grid>
          </Border>

          <!-- Orta: Şarkı adı ve sanatçı -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
            <TextBlock Text="{Binding Music.Title}"
                       Foreground="{StaticResource NotchForeground}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock Text="{Binding Music.Artist}"
                       Foreground="#99FFFFFF"
                       FontSize="9"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
          </StackPanel>

          <!-- Sağ: Oynatma göstergesi -->
          <Canvas Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center" Opacity="0.9">
            <Line X1="2" Y1="3" X2="2" Y2="11" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line X1="6" Y1="1" X2="6" Y2="13" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line X1="10" Y1="4" X2="10" Y2="10" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Canvas>
        </Grid>

        <!-- 3. Expanded Durumu -->
        <Grid x:Name="ExpandedView" Margin="12,0,12,0">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}" Value="{x:Static core:NotchState.Expanded}" />
                    <Condition Binding="{Binding Osd.IsActive}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>

          <!-- Panel Seçici / İçerik: Music, ControlCenter, Status, Calendar, Shelf -->
          <ContentControl Content="{Binding CurrentPanelContent}">
            <ContentControl.RenderTransform>
              <TranslateTransform x:Name="PanelTranslate" X="0" />
            </ContentControl.RenderTransform>
            <ContentControl.Resources>
              <DataTemplate DataType="{x:Type music:MusicViewModel}">
                <music:MusicPanel />
              </DataTemplate>
              <DataTemplate DataType="{x:Type cc:ControlCenterViewModel}">
                <cc:ControlCenterPanel />
              </DataTemplate>
              <DataTemplate DataType="{x:Type status:StatusViewModel}">
                <status:StatusPanel />
              </DataTemplate>
              <DataTemplate DataType="{x:Type cal:CalendarViewModel}">
                <cal:CalendarPanel />
              </DataTemplate>
              <DataTemplate DataType="{x:Type shelf:ShelfViewModel}">
                <shelf:ShelfPanel />
              </DataTemplate>
            </ContentControl.Resources>
          </ContentControl>
        </Grid>
      </Grid>
    </local:NotchShape>
  </Grid>
</Window>
