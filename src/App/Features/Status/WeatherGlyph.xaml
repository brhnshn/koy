<UserControl x:Class="Koy.App.Features.Status.WeatherGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Hava durumu simgesi; DataContext StatusViewModel (WeatherIconKind). Güneş, bulut, yağmur, kar, sis, fırtına. -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
      <!-- Güneş (Sun) -->
      <Path Width="18" Height="18" Stretch="Uniform" Fill="#F59E0B"
            Data="M 12,7 A 5,5 0 1 1 7,12 A 5,5 0 0 1 12,7 M 12,1 L 12,4 M 12,20 L 12,23 M 4.22,4.22 L 6.34,6.34 M 17.66,17.66 L 19.78,19.78 M 1,12 L 4,12 M 20,12 L 23,12 M 4.22,19.78 L 6.34,17.66 M 17.66,6.34 L 19.78,4.22"
            Stroke="#F59E0B" StrokeThickness="1.2">
        <Path.Style>
          <Style TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding WeatherIconKind}" Value="Sun">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Path.Style>
      </Path>

      <!-- Bulut (Cloud / Default fallback) -->
      <Path Width="18" Height="18" Stretch="Uniform" Fill="#CCCCCC"
            Data="M 19.35,10.04 C 18.67,6.59 15.64,4 12,4 C 9.11,4 6.6,5.64 5.35,8.04 C 2.34,8.36 0,10.91 0,14 C 0,17.31 2.69,20 6,20 L 19,20 C 21.76,20 24,17.76 24,15 C 24,12.36 21.95,10.22 19.35,10.04 Z">
        <Path.Style>
          <Style TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding WeatherIconKind}" Value="Cloud">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Path.Style>
      </Path>

      <!-- Parçalı Bulutlu (PartlyCloudy) -->
      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding WeatherIconKind}" Value="PartlyCloudy">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Path Width="12" Height="12" Stretch="Uniform" Fill="#F59E0B" Margin="-4,-6,0,0"
              Data="M 12,7 A 5,5 0 1 1 7,12 A 5,5 0 0 1 12,7 M 12,1 L 12,4 M 1,12 L 4,12"
              Stroke="#F59E0B" StrokeThickness="1.2" />
        <Path Width="16" Height="14" Stretch="Uniform" Fill="#CCCCCC" Margin="2,4,0,0"
              Data="M 19.35,10.04 C 18.67,6.59 15.64,4 12,4 C 9.11,4 6.6,5.64 5.35,8.04 C 2.34,8.36 0,10.91 0,14 C 0,17.31 2.69,20 6,20 L 19,20 C 21.76,20 24,17.76 24,15 C 24,12.36 21.95,10.22 19.35,10.04 Z" />
      </Grid>

      <!-- Yağmur (Rain / Drizzle) -->
      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding WeatherIconKind}" Value="Rain">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding WeatherIconKind}" Value="Drizzle">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Path Width="16" Height="12" Stretch="Uniform" Fill="#B0BEC5"
              Data="M 19.35,10.04 C 18.67,6.59 15.64,4 12,4 C 9.11,4 6.6,5.64 5.35,8.04 C 2.34,8.36 0,10.91 0,14 C 0,17.31 2.69,20 6,20 L 19,20 C 21.76,20 24,17.76 24,15 C 24,12.36 21.95,10.22 19.35,10.04 Z" />
        <Path Width="12" Height="6" Stretch="Uniform" Stroke="#60A5FA" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,16,0,0"
              Data="M 4,1 L 2,6 M 8,1 L 6,6 M 12,1 L 10,6" />
      </Grid>

      <!-- Kar (Snow) -->
      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding WeatherIconKind}" Value="Snow">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Path Width="16" Height="12" Stretch="Uniform" Fill="#B0BEC5"
              Data="M 19.35,10.04 C 18.67,6.59 15.64,4 12,4 C 9.11,4 6.6,5.64 5.35,8.04 C 2.34,8.36 0,10.91 0,14 C 0,17.31 2.69,20 6,20 L 19,20 C 21.76,20 24,17.76 24,15 C 24,12.36 21.95,10.22 19.35,10.04 Z" />
        <Path Width="12" Height="6" Stretch="Uniform" Fill="#E0F2FE" Margin="0,15,0,0"
              Data="M 3,1 A 1,1 0 1 1 3,3 A 1,1 0 0 1 3,1 M 7,1 A 1,1 0 1 1 7,3 A 1,1 0 0 1 7,1 M 11,1 A 1,1 0 1 1 11,3 A 1,1 0 0 1 11,1" />
      </Grid>

      <!-- Sis (Fog) -->
      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding WeatherIconKind}" Value="Fog">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Path Width="16" Height="10" Stretch="Uniform" Fill="#90A4AE"
              Data="M 19.35,10.04 C 18.67,6.59 15.64,4 12,4 C 9.11,4 6.6,5.64 5.35,8.04 C 2.34,8.36 0,10.91 0,14 C 0,17.31 2.69,20 6,20 L 19,20 C 21.76,20 24,17.76 24,15 C 24,12.36 21.95,10.22 19.35,10.04 Z" />
        <Path Width="14" Height="6" Stretch="Uniform" Stroke="#B0BEC5" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,15,0,0"
              Data="M 2,1 L 18,1 M 4,4 L 16,4" />
      </Grid>

      <!-- Fırtına (Thunderstorm) -->
      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding WeatherIconKind}" Value="Thunderstorm">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Path Width="16" Height="12" Stretch="Uniform" Fill="#78909C"
              Data="M 19.35,10.04 C 18.67,6.59 15.64,4 12,4 C 9.11,4 6.6,5.64 5.35,8.04 C 2.34,8.36 0,10.91 0,14 C 0,17.31 2.69,20 6,20 L 19,20 C 21.76,20 24,17.76 24,15 C 24,12.36 21.95,10.22 19.35,10.04 Z" />
        <Path Width="8" Height="10" Stretch="Uniform" Fill="#FBBF24" Margin="0,14,0,0"
              Data="M 7,2 L 2,9 L 6,9 L 4,16 L 11,8 L 7,8 Z" />
      </Grid>
    </Grid>
</UserControl>
