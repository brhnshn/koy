<UserControl x:Class="Koy.App.Features.Music.MusicPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Music"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:MusicViewModel}"
             Foreground="{StaticResource NotchForeground}"
             FontSize="12">

  <UserControl.Resources>
    <!-- Vektör ikon düğmesi stili -->
    <Style x:Key="MediaButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="16" Padding="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BtnBorder" Property="Background" Value="#25FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BtnBorder" Property="Background" Value="#45FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <Grid Margin="16,10,16,14">
    <!-- Parça yoksa gösterilecek durum -->
    <!-- Görünürlük yalnız stilden gelir: satır içi Visibility stil tetikleyicisini ezer. -->
    <Grid>
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasTrack}" Value="False">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal" Opacity="0.6">
        <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource NotchForeground}" Margin="0,0,8,0"
              Data="M 12,3 L 6,5 L 6,11 A 2.5,2.5 0 1 1 3.5,8.5 L 5,8.5 L 5,4 L 12,2 Z" />
        <TextBlock Text="{x:Static res:Strings.NoMediaPlaying}" VerticalAlignment="Center" FontSize="13" />
      </StackPanel>
    </Grid>

    <!-- Parça varsa ana panel düzeni -->
    <Grid Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Üst satır: Kapak + Başlık/Sanatçı + Oynatma Düğmeleri -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Albüm Kapağı veya Vektör Nota Simgesi -->
        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#1FFFFFFF" ClipToBounds="True">
          <Grid>
            <!-- Yedek vektör ikon -->
            <Path Width="20" Height="20" Stretch="Uniform" Fill="#60FFFFFF"
                  Data="M 12,3 L 6,5 L 6,11 A 2.5,2.5 0 1 1 3.5,8.5 L 5,8.5 L 5,4 L 12,2 Z"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- Gerçek kapak resmi -->
            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
          </Grid>
        </Border>

        <!-- Parça Bilgileri -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
          <TextBlock Text="{Binding Title}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Foreground="{StaticResource NotchForeground}"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap" />
          <TextBlock Text="{Binding Artist}"
                     FontSize="11"
                     Foreground="#99FFFFFF"
                     Margin="0,2,0,0"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <!-- Videolarda sanatçı boş gelir; boş satır başlıkla uygulama adı arasında boşluk bırakmasın. -->
                  <DataTrigger Binding="{Binding Artist}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding SourceAppId}"
                     FontSize="9"
                     Foreground="#66FFFFFF"
                     Margin="0,2,0,0"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap" />
        </StackPanel>

        <!-- Kontrol Düğmeleri: Geri, Oynat/Duraklat, İleri -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Önceki Düğmesi -->
          <Button Style="{StaticResource MediaButtonStyle}" Width="32" Height="32" Command="{Binding PreviousCommand}" ToolTip="Önceki">
            <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource NotchForeground}"
                  Data="M 11,3 L 4,8.5 L 11,14 Z M 3,3 L 1,3 L 1,14 L 3,14 Z" />
          </Button>

          <!-- Oynat / Duraklat Düğmesi -->
          <Button Style="{StaticResource MediaButtonStyle}" Width="36" Height="36" Margin="4,0" Command="{Binding PlayPauseCommand}" ToolTip="Oynat / Duraklat">
            <Grid>
              <!-- Oynat simgesi (IsPlaying == False) -->
              <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource NotchForeground}"
                    Data="M 4,2 L 14,8 L 4,14 Z">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
              <!-- Duraklat simgesi (IsPlaying == True) -->
              <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource NotchForeground}"
                    Data="M 3,2 L 6,2 L 6,14 L 3,14 Z M 10,2 L 13,2 L 13,14 L 10,14 Z">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Grid>
          </Button>

          <!-- Sonraki Düğmesi -->
          <Button Style="{StaticResource MediaButtonStyle}" Width="32" Height="32" Command="{Binding NextCommand}" ToolTip="Sonraki">
            <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource NotchForeground}"
                  Data="M 3,3 L 10,8.5 L 3,14 Z M 11,3 L 13,3 L 13,14 L 11,14 Z" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Alt satır: İlerleme Çubuğu ve Süreler -->
      <Grid Grid.Row="1" Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="10" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />

        <!-- İlerleme Çubuğu (Tıklanabilir) -->
        <ProgressBar Grid.Column="1"
                     Minimum="0" Maximum="1"
                     Value="{Binding Progress, Mode=OneWay}"
                     Height="4"
                     VerticalAlignment="Center"
                     Background="#25FFFFFF"
                     Foreground="{StaticResource NotchForeground}"
                     BorderThickness="0"
                     Cursor="Hand"
                     MouseLeftButtonDown="ProgressBar_MouseLeftButtonDown" />

        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
