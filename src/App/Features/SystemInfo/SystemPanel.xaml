<UserControl x:Class="Koy.App.Features.SystemInfo.SystemPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.SystemInfo"
             xmlns:focus="clr-namespace:Koy.App.Features.Focus"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SystemStatsViewModel}"
             Foreground="{DynamicResource KoyNotchText}"
             FontSize="12">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- İşlemci -->
    <Border Grid.Column="0" CornerRadius="22" Background="{DynamicResource KoyNotchSystemCard}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid Width="108" Height="108">
          <focus:ArcRing Progress="{Binding CpuProgress}" Thickness="9"
                         TrackBrush="{DynamicResource KoyNotchSystemTrack}" FillBrush="{DynamicResource KoyNotchAccentSystem}" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding CpuText}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding [SystemProcessor], Source={x:Static res:Loc.Instance}}" FontSize="10"
                       Foreground="{DynamicResource KoyNotchSystemSoft}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding TopProcessText}" FontSize="11" Foreground="{DynamicResource KoyNotchSystemSoft}" Margin="0,10,0,0"
                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
      </StackPanel>
    </Border>

    <!-- Bellek -->
    <Border Grid.Column="2" CornerRadius="22" Background="{DynamicResource KoyNotchSystemCard}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid Width="108" Height="108">
          <focus:ArcRing Progress="{Binding RamProgress}" Thickness="9"
                         TrackBrush="{DynamicResource KoyNotchSystemTrack}" FillBrush="{DynamicResource KoyNotchAccentSystem}" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding RamText}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding [SystemMemory], Source={x:Static res:Loc.Instance}}" FontSize="10"
                       Foreground="{DynamicResource KoyNotchSystemSoft}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding MemoryDetailText}" FontSize="11" Foreground="{DynamicResource KoyNotchSystemSoft}" Margin="0,10,0,0" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Ağ ve Koy'un kendi belleği -->
    <Grid Grid.Column="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="8" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border CornerRadius="18" Background="{DynamicResource KoyNotchNetCard}" Padding="12">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding NetworkName}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding DownloadText}" FontSize="12" Foreground="{DynamicResource KoyNotchNetSoft}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding UploadText}" FontSize="12" Foreground="{DynamicResource KoyNotchNetSoft}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Row="2" CornerRadius="18" Background="{DynamicResource KoyNotchCard}" Padding="12">
        <StackPanel>
          <TextBlock Text="{Binding [SystemKoySelf], Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" />
          <TextBlock Text="{Binding KoyMemoryText}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
