<Window x:Class="Koy.App.Features.Wizard.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koy.App.Features.Wizard"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:SetupWizardViewModel}"
        Title="Koy İlk Kurulum"
        Width="880"
        Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        Foreground="#F4F4F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="WizardNavButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#27272A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WizardPrimaryButton" TargetType="Button" BasedOn="{StaticResource WizardNavButton}">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Ana Pencere Gövdesi -->
    <Border Background="#18181B"
            BorderBrush="#2E2E33"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" /> <!-- Başlık çubuğu / sürükleme alanı -->
                <RowDefinition Height="*" />  <!-- Adım içeriği -->
                <RowDefinition Height="76" /> <!-- Alt gezinme çubuğu -->
            </Grid.RowDefinitions>

            <!-- Başlık çubuğu -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent" Margin="16,4,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Fill="#3B82F6" Data="{StaticResource KoyLogoGeometry}" Width="16" Height="16" Stretch="Uniform" />
                    <TextBlock Text="Koy Kurulum" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0" Foreground="#A1A1AA" Cursor="Hand" Click="Close_Click">
                    <TextBlock Text="✕" FontSize="12" />
                </Button>
            </Grid>

            <!-- ADIM 1: Hoş Geldiniz ve Dil Seçimi -->
            <Grid Grid.Row="1" Margin="56,20,56,0" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Center">
                    <TextBlock Text="Adım 1 / 3" FontSize="13" Foreground="#A1A1AA" Margin="0,0,0,8" />
                    <TextBlock Text="Koy'a Hoş Geldiniz" FontSize="32" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="0,0,0,10" />
                    <TextBlock Text="Windows 11 için akıllı çentik ve minimalist yüzen dock. Başlamadan önce tercihlerinizi belirleyelim."
                               FontSize="15" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,28" LineHeight="22" />

                    <!-- Dil Seçimi Bölümü -->
                    <Border Background="#1F1F23" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Arayüz Dili" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" />
                                <TextBlock Text="Uygulama içinde kullanılacak dili seçin." FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="140" Height="36" VerticalAlignment="Center"
                                      SelectedValuePath="Tag" SelectedValue="{Binding SelectedLanguage}"
                                      Style="{StaticResource SettingComboBoxStyle}">
                                <ComboBoxItem Content="Türkçe" Tag="tr" />
                                <ComboBoxItem Content="English" Tag="en" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ADIM 2: Koy ekranında ne olsun? (3 Kartlı Seçim) -->
            <Grid Grid.Row="1" Margin="56,16,56,0" Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Adım 2 / 3" FontSize="13" Foreground="#A1A1AA" Margin="0,0,0,8" />
                    <TextBlock Text="Koy ekranında ne olsun?" FontSize="28" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="0,0,0,6" />
                    <TextBlock Text="Sonra Koy penceresinden istediğin zaman değiştirebilirsin." FontSize="14" Foreground="#A1A1AA" Margin="0,0,0,24" />

                    <!-- 3 Kartlı Izgara -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Kart 0: Çentik ve dock -->
                        <Border Grid.Column="0" Height="248" CornerRadius="14" Background="#1F1F23" Cursor="Hand" MouseLeftButtonDown="Card0_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="BorderBrush" Value="#2E2E33" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLayoutIndex}" Value="0">
                                            <Setter Property="BorderBrush" Value="#3B82F6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Üst Önizleme Tuvali -->
                                <Border Grid.Row="0" Background="#243445" CornerRadius="12,12,0,0">
                                    <Grid>
                                        <!-- Mini Çentik -->
                                        <Border Width="64" Height="12" Background="#0A0A0B" CornerRadius="0,0,7,7"
                                                HorizontalAlignment="Center" VerticalAlignment="Top" />
                                        <!-- Mini Dock -->
                                        <Border Width="120" Height="18" Background="#E618181B" CornerRadius="7"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                                    </Grid>
                                </Border>
                                <!-- Alt Açıklama -->
                                <StackPanel Grid.Row="1" Margin="14,12">
                                    <TextBlock Text="Çentik ve dock" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" />
                                    <TextBlock Text="Windows görev çubuğu gizlenir, yerine Koy dock'u gelir."
                                               FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="16" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Kart 1: Yalnız çentik -->
                        <Border Grid.Column="2" Height="248" CornerRadius="14" Background="#1F1F23" Cursor="Hand" MouseLeftButtonDown="Card1_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="BorderBrush" Value="#2E2E33" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLayoutIndex}" Value="1">
                                            <Setter Property="BorderBrush" Value="#3B82F6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#243445" CornerRadius="12,12,0,0">
                                    <Grid>
                                        <!-- Mini Çentik -->
                                        <Border Width="64" Height="12" Background="#0A0A0B" CornerRadius="0,0,7,7"
                                                HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="14,12">
                                    <TextBlock Text="Yalnız çentik" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" />
                                    <TextBlock Text="Windows görev çubuğu olduğu gibi kalır."
                                               FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="16" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Kart 2: Yalnız dock -->
                        <Border Grid.Column="4" Height="248" CornerRadius="14" Background="#1F1F23" Cursor="Hand" MouseLeftButtonDown="Card2_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="BorderBrush" Value="#2E2E33" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLayoutIndex}" Value="2">
                                            <Setter Property="BorderBrush" Value="#3B82F6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#243445" CornerRadius="12,12,0,0">
                                    <Grid>
                                        <!-- Mini Dock -->
                                        <Border Width="120" Height="18" Background="#E618181B" CornerRadius="7"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="14,12">
                                    <TextBlock Text="Yalnız dock" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" />
                                    <TextBlock Text="Çentik kapalı; saat ve pil dock'un sağ ucunda."
                                               FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="16" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ADIM 3: Başlangıç ve İzinler / Tamamlandı -->
            <Grid Grid.Row="1" Margin="56,20,56,0" Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Center">
                    <TextBlock Text="Adım 3 / 3" FontSize="13" Foreground="#A1A1AA" Margin="0,0,0,8" />
                    <TextBlock Text="Her şey hazır!" FontSize="32" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="0,0,0,10" />
                    <TextBlock Text="Seçimleriniz uygulandı. İstediğiniz zaman sağ alttaki menüden veya Koy penceresinden ayarları güncelleyebilirsiniz."
                               FontSize="15" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,28" LineHeight="22" />

                    <!-- Başlangıç Seçeneği -->
                    <Border Background="#1F1F23" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Windows açılınca Koy'u başlat" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" />
                                <TextBlock Text="Bilgisayarınız açıldığında otomatik olarak arka planda çalışsın."
                                           FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding RunAtStartup}"
                                      Style="{StaticResource ModernCheckBoxStyle}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Alt Gezinme Çubuğu (76 px) -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#232327" Padding="56,0">
                <Grid VerticalAlignment="Center">
                    <!-- Sol: 3 Hap Noktası -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- Nokta 1 -->
                        <Border x:Name="dot1" CornerRadius="4" Height="8" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="8" />
                                    <Setter Property="Background" Value="#52525B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                            <Setter Property="Width" Value="24" />
                                            <Setter Property="Background" Value="#3B82F6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Nokta 2 -->
                        <Border x:Name="dot2" CornerRadius="4" Height="8" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="8" />
                                    <Setter Property="Background" Value="#52525B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Width" Value="24" />
                                            <Setter Property="Background" Value="#3B82F6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Nokta 3 -->
                        <Border x:Name="dot3" CornerRadius="4" Height="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="8" />
                                    <Setter Property="Background" Value="#52525B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Width" Value="24" />
                                            <Setter Property="Background" Value="#3B82F6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>

                    <!-- Sağ: Geri ve Devam Düğmeleri -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Geri"
                                Style="{StaticResource WizardNavButton}"
                                Command="{Binding BackCommand}"
                                Margin="0,0,10,0"
                                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{Binding NextButtonText}"
                                Style="{StaticResource WizardPrimaryButton}"
                                Command="{Binding NextCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
