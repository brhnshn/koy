<Application x:Class="Koy.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Tema, token, ikon ve bileşen sözlükleri ThemeManager.Install ile yüklenir (Resources/ThemeManager.cs). -->
      <!-- Çentik renkleri temadan bağımsızdır, burada kalır. -->
      <SolidColorBrush x:Key="NotchBackground" Color="#F0000000" />
      <SolidColorBrush x:Key="NotchForeground" Color="#FFFFFFFF" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
