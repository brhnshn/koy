<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Temadan bağımsız tasarım token'ları: yazı tipi, boyut, boşluk, köşe, ölçüler.
        Boşluk ölçeği 4'ün katıdır (Corvus ile aynı mantık). Köşe yarıçapları Standart seçimdir;
        Görünüm > Köşe yuvarlaklığı değişince ThemeManager aynı anahtarları uygulama düzeyinde ezer (DynamicResource).
    -->

    <!-- Yazı tipi -->
    <FontFamily x:Key="KoyFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="KoyFontMono">Consolas</FontFamily>

    <!-- Yazı boyutları -->
    <sys:Double x:Key="KoyFontPageTitle">20</sys:Double>
    <sys:Double x:Key="KoyFontSubtitle">12.5</sys:Double>
    <sys:Double x:Key="KoyFontSection">11.5</sys:Double>
    <sys:Double x:Key="KoyFontRowTitle">13.5</sys:Double>
    <sys:Double x:Key="KoyFontBody">13</sys:Double>
    <sys:Double x:Key="KoyFontControl">12.5</sys:Double>
    <sys:Double x:Key="KoyFontCaption">12</sys:Double>
    <sys:Double x:Key="KoyFontKey">11.5</sys:Double>

    <!-- Boşluk ölçeği (DIP) -->
    <sys:Double x:Key="KoySpace1">4</sys:Double>
    <sys:Double x:Key="KoySpace2">8</sys:Double>
    <sys:Double x:Key="KoySpace3">12</sys:Double>
    <sys:Double x:Key="KoySpace4">16</sys:Double>
    <sys:Double x:Key="KoySpace5">24</sys:Double>
    <sys:Double x:Key="KoySpace6">32</sys:Double>

    <!-- Köşe yarıçapları (Standart) -->
    <CornerRadius x:Key="KoyRadiusWindow">12</CornerRadius>
    <CornerRadius x:Key="KoyRadiusWindowTop">11,11,0,0</CornerRadius>
    <CornerRadius x:Key="KoyRadiusWindowBottomLeft">0,0,0,11</CornerRadius>
    <CornerRadius x:Key="KoyRadiusRow">8</CornerRadius>
    <CornerRadius x:Key="KoyRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="KoyRadiusSmall">4</CornerRadius>

    <!-- Ölçüler -->
    <sys:Double x:Key="KoyControlHeight">28</sys:Double>
    <sys:Double x:Key="KoyRowMinHeight">52</sys:Double>
    <sys:Double x:Key="KoyNavItemHeight">34</sys:Double>
    <sys:Double x:Key="KoyIconSize">16</sys:Double>
    <sys:Double x:Key="KoyIconSizeLarge">20</sys:Double>
    <sys:Double x:Key="KoyIconStroke">2</sys:Double>

    <!-- Temadan bağımsız (sabit koyu) yüzeyler: dock ve çentik koyu kalır, bu yüzden bağlam menüsü ve kaydırma çubuğu da tema değiştirmez. -->
    <SolidColorBrush x:Key="KoyMenuBg" Color="#18181B" />
    <SolidColorBrush x:Key="KoyMenuBorder" Color="#2E2E33" />
    <SolidColorBrush x:Key="KoyMenuText" Color="#F4F4F5" />
    <SolidColorBrush x:Key="KoyMenuTextMuted" Color="#8B8B95" />
    <SolidColorBrush x:Key="KoyMenuTextDisabled" Color="#71717A" />
    <SolidColorBrush x:Key="KoyMenuHover" Color="#2E2E35" />
    <SolidColorBrush x:Key="KoyMenuSeparator" Color="#2E2E33" />

    <!-- Çentik her zaman koyu yüzeydir (temadan bağımsız). Sekmeler ve durum simgeleri bu fırçaları kullanır. -->
    <SolidColorBrush x:Key="KoyNotchText" Color="#F4F4F5" />
    <SolidColorBrush x:Key="KoyNotchTextSecondary" Color="#D4D4D8" />
    <!-- Seçili sekmenin (açık dolgu) üstündeki koyu yazı: çentik yüzeyiyle aynı renk -->
    <SolidColorBrush x:Key="KoyNotchTextOnLight" Color="#0A0A0B" />
    <!-- Beyazın %10'u: koyu yüzeyde fare üstü katmanı (yarı saydam olduğu için token karşılığı yok) -->
    <SolidColorBrush x:Key="KoyNotchHover" Color="#1AFFFFFF" />
    <!-- Beyazın %20'si ve %15'i: koyu yüzeyde basılı ve açık (seçili) düğme katmanı (dock tepsi düğmesi) -->
    <SolidColorBrush x:Key="KoyNotchPressed" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="KoyNotchActive" Color="#26FFFFFF" />
    <!-- Çentikte ikincil yazı (DESIGN: #A1A1AA) ve bölümleri ayıran ince çizgi -->
    <SolidColorBrush x:Key="KoyNotchTextMuted" Color="#A1A1AA" />
    <SolidColorBrush x:Key="KoyNotchDivider" Color="#20FFFFFF" />
    <!-- Açılır pencerelerin gölgesi (DropShadowEffect fırça değil renk ister) -->
    <Color x:Key="KoyShadowColor">#000000</Color>

    <!-- Yarı saydam gri: hem koyu hem açık yüzeyde okunur. -->
    <SolidColorBrush x:Key="KoyScrollThumb" Color="#66808088" />
    <SolidColorBrush x:Key="KoyScrollThumbHover" Color="#99808088" />
    <SolidColorBrush x:Key="KoyScrollThumbDrag" Color="#CC808088" />
</ResourceDictionary>
